---
import BaseLayout from '../layouts/BaseLayout.astro';
import FestivalRoadmap from '../components/FestivalRoadmap.astro';

const faqs = [
  {
    q: 'Which festivals are you at in 2026?',
    a: 'Our confirmed 2026 lineup — Cheltenham Jazz Festival, The Big Retreat, <a href="/blog/2000trees-2026/">2000trees</a>, Electromagnetic Field, Camp Bestival, Lakefest, Beautiful Days, Forwards Festival and We Have Ways. Nine events from April to September. Follow the <a href="/blog">Castaway blog</a> for festival countdowns and updates.',
  },
  {
    q: 'What food do you serve at festivals?',
    a: "Greek gyros (chicken, pork or halloumi), Korean bowls and poke bowls. Everything made fresh to order. We run fast — you won't be standing in a long queue.",
  },
  {
    q: 'Do you have vegetarian and vegan options?',
    a: 'Yes — across all three menus. Halloumi gyros, tofu Korean bowls and vegan poke are all available. Ask at the unit if you\'re unsure about any dish.',
  },
  {
    q: 'Do you take card payments at festivals?',
    a: 'Yes — we accept card and contactless at all events. We also accept cash. No surprises at the front of the queue.',
  },
  {
    q: 'How do I find the Castaway Kitchen unit on site?',
    a: "We'll share our pitch location on social before and during each event. Follow us on Instagram and Facebook for live updates.",
  },
  {
    q: 'How long is the queue typically?',
    a: "We've been trained on busy festival circuits — fast service is something we're proud of. Peak times will always have a short wait but we run two units and an efficient team. It moves quickly.",
  },
  {
    q: "I'm a festival organiser — how do I book Castaway Kitchen?",
    a: 'Use our <a href="/contact">contact form</a> and select the festival/event organiser option. Tell us about your event — capacity, dates, location — and we\'ll get back to you within 24 hours.',
  },
  {
    q: 'Do you do private catering as well as festivals?',
    a: 'Yes — weddings, private parties, corporate events. The same great food, brought to your venue. See our <a href="/private-catering">Private Catering page</a> for details.',
  },
];
---

<BaseLayout
  title="Festivals"
  description="Castaway Kitchen on the 2026 festival circuit — Lakefest, 2000 Trees, Cheltenham Jazz & more. Greek gyros, Korean bowls & poke. Find us, follow us, come hungry."
>

  <!-- HERO -->
  <section class="page-hero section--dark">
    <div class="container">
      <p class="eyebrow">Season in progress</p>
      <h1 class="display page-hero-title">2026 Festival Tour</h1>
      <p class="page-hero-body">
        Nine festivals. Two units. One crew. We're on the road from April to September — find us, follow us, come hungry.
      </p>
    </div>
  </section>

  <!-- ROADMAP -->
  <section class="section roadmap-section">
    <div class="container">
      <FestivalRoadmap />
    </div>
  </section>

  <!-- ORGANISER CTA -->
  <section class="section--dark section organiser-cta">
    <div class="container organiser-cta-inner">
      <div>
        <p class="eyebrow">Festival organisers</p>
        <h2 class="display organiser-title">Running an event?</h2>
        <p class="organiser-body">
          Two fully equipped units, a proven team and a track record at established UK events.
          Get in touch if you'd like us at your festival.
        </p>
        <a href="/contact" class="btn btn--primary" style="margin-top: var(--space-md)">Get in Touch</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section--sand section faq">
    <div class="container">
      <p class="eyebrow">Common questions</p>
      <h2 class="display faq-title">Festival FAQs</h2>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span>{item.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <p class="faq-answer" set:html={item.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  .page-hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    color: var(--white);
    margin: var(--space-xs) 0 var(--space-md);
    line-height: 0.95;
  }

  .page-hero-body {
    font-size: var(--text-lg);
    color: rgba(255,255,255,0.7);
    max-width: 560px;
    line-height: 1.7;
  }

  .roadmap-section {
    background: var(--off-white);
  }

  .organiser-cta-inner {
    max-width: 640px;
  }

  .organiser-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--white);
    margin: var(--space-sm) 0 var(--space-md);
  }

  .organiser-body {
    color: rgba(255,255,255,0.7);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .faq-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin: var(--space-sm) 0 var(--space-xl);
  }

  .faq-list {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .faq-item {
    background: var(--white);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    cursor: pointer;
    font-weight: 800;
    font-size: var(--text-base);
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker { display: none; }
  .faq-icon { font-size: var(--text-xl); font-weight: 400; color: var(--teal); flex-shrink: 0; transition: transform 0.2s; }
  .faq-item[open] .faq-icon { transform: rotate(45deg); }
  ..faq-answer { padding: 0 var(--space-lg) var(--space-md); font-size: var(--text-sm); color: var(--warm-grey); line-height: 1.7; }
  .faq-answer :global(a) { color: var(--teal); font-weight: 700; }
</style>