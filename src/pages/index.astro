---
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

const events = [
  {
    type: 'wedding',
    title: 'Weddings',
    body: 'Evening food your guests will actually talk about. Gyros at golden hour beats a cold buffet every time.',
    img: '/image-assets/gallery-gyros-teal.webp',
    alt: 'A chicken gyros loaded with fries and salad, held up against a teal background',
  },
  {
    type: 'party',
    title: 'Birthdays & garden parties',
    body: 'Big birthdays, anniversaries, village dos and back-garden blowouts. You host, we feed.',
    img: '/image-assets/punters-trio-wraps.webp',
    alt: 'Three friends grinning with Castaway Kitchen gyros wraps',
  },
  {
    type: 'corporate',
    title: 'Corporate & staff events',
    body: 'Summer socials, away days, product launches and thank-you lunches. Invoicing sorted.',
    img: '/image-assets/crew-ketchup-cheers.webp',
    alt: 'Two Castaway Kitchen crew members raising a cheers behind the serving counter',
  },
  {
    type: 'christmas',
    title: 'Christmas & winter parties',
    body: 'Hot, loaded and made to order. Works Christmas dos, winter weddings and New Year bashes.',
    img: '/image-assets/punters-two-girls.webp',
    alt: 'A gyros wrap with chips held up against a dark blue sky',
  },
];

const faqs = [
  {
    q: 'What events do you cater?',
    a: 'Weddings, birthdays, garden parties, corporate and staff events, Christmas parties, and anything else where a crowd needs feeding. We also still trade at a handful of festivals each summer.',
  },
  {
    q: 'How many guests can you feed?',
    a: 'From around 30 guests up to several hundred. With two fully equipped units we can scale up for bigger events without slowing service down.',
  },
  {
    q: 'What do we need to provide?',
    a: "Not much. We're fully self-sufficient with our own power and equipment, so we can trade at barns, private estates, marquees and open fields without an on-site kitchen. We bring the staff, set up, serve and clear away.",
  },
  {
    q: 'How far ahead should we book?',
    a: 'For summer weekends (June to September) aim for three months ahead or more, as those dates go first. Winter and spring events usually have more flexibility. Send us your date and we\'ll check.',
  },
  {
    q: 'Can you handle dietary requirements?',
    a: 'Yes. Vegetarian and vegan options run across all three menus, including halloumi gyros, tofu Korean bowls and vegan poke. Flag any allergies when you enquire and we\'ll make sure nobody misses out.',
  },
  {
    q: 'Where do you cover?',
    a: 'We\'re based in Moreton-in-Marsh, Gloucestershire, and regularly cover the <a href="/private-catering/cotswolds/">Cotswolds</a>, Cheltenham, Oxfordshire, Bristol, <a href="/private-catering/cornwall/">Cornwall</a>, Devon and the wider South West. For bigger events we\'ll travel further. Just ask.',
  },
];
---

<BaseLayout
  title="Home"
  description="Festival street food for your private event. Greek gyros, Korean bowls and poke, cooked live for weddings, parties and corporate events across the Cotswolds, Cornwall and South West. Quotes within 24 hours."
  schema={true}
>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <p class="eyebrow hero-eyebrow">Private event catering · Cotswolds, Cornwall &amp; South West</p>
        <h1 class="display hero-headline">
          Festival food.<br />
          Your event.<br />
          <span class="hero-headline--teal">Sorted.</span>
        </h1>
        <p class="hero-body">
          Greek gyros, Korean bowls and poke, cooked live for your guests. Weddings, birthdays,
          staff parties and summer dos, fully staffed and fully self-sufficient.
        </p>
        <div class="hero-ctas">
          <a href="#enquire" class="btn btn--primary">Get a Quote</a>
          <a href="#events" class="btn btn--outline">What We Cater</a>
        </div>
        <ul class="hero-trust" aria-label="Why book Castaway Kitchen">
          <li>Trading since 2015</li>
          <li>30 to several hundred guests</li>
          <li>Own power &amp; kit</li>
          <li>NCASS member</li>
        </ul>
      </div>
      <div class="hero-badge" aria-hidden="true">
        <img src="/castaway-logo.png" alt="" width="260" height="260" class="hero-logo-reveal" />
      </div>
    </div>
  </section>

  <!-- ===== BOOKING STRIP ===== -->
  <section class="booking-strip">
    <div class="container booking-strip-inner">
      <p><strong>Now booking 2027 private events.</strong> Summer weekends go first, so get your date in early.</p>
      <a href="#enquire" class="booking-strip-link">Check your date →</a>
    </div>
  </section>

  <!-- ===== EVENT TYPES ===== -->
  <section class="section events" id="events">
    <div class="container">
      <p class="eyebrow">What we cater</p>
      <h2 class="display section-title">Your party. Our kitchen.</h2>
      <p class="section-lede">
        The same food that keeps festival queues moving, brought to your venue, field or garden.
        Summer or winter, we'll tailor the menu to your crowd.
      </p>
      <div class="events-grid">
        {events.map((e) => (
          <a href={`/?type=${e.type}#enquire`} class="event-card">
            <div class="event-card-img">
              <img src={e.img} alt={e.alt} loading="lazy" width="600" height="600" />
            </div>
            <div class="event-card-body">
              <h3 class="display event-card-title">{e.title}</h3>
              <p>{e.body}</p>
              <span class="event-card-link">Enquire →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PROOF BAND ===== -->
  <section class="proof section--dark">
    <img src="/image-assets/gallery-unit-queue.webp" alt="" aria-hidden="true" class="proof-bg" loading="lazy" />
    <div class="container proof-inner">
      <div class="proof-copy">
        <p class="eyebrow">Festival-proven</p>
        <h2 class="display proof-title">If we can feed a festival field at peak, your party's in safe hands.</h2>
        <p class="proof-body">
          We've spent over a decade serving queues at festivals across the UK. That means fast service,
          a crew that knows the drill, and kit that works anywhere.
        </p>
      </div>
      <div class="proof-stats">
        <div class="proof-stat"><span class="display proof-num">2015</span><span class="proof-label">Trading since</span></div>
        <div class="proof-stat"><span class="display proof-num">10</span><span class="proof-label">Festivals in 2026</span></div>
        <div class="proof-stat"><span class="display proof-num">2</span><span class="proof-label">Fully equipped units</span></div>
        <div class="proof-stat"><span class="display proof-num">30+</span><span class="proof-label">Guests, up to several hundred</span></div>
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="section how">
    <div class="container how-inner">
      <div>
        <p class="eyebrow">How it works</p>
        <h2 class="display section-title">Three steps. Zero faff.</h2>
        <ol class="how-steps">
          <li>
            <span class="display how-num">01</span>
            <div>
              <h3>Tell us the basics</h3>
              <p>Date, rough guest numbers, where and what kind of do. Takes a minute.</p>
            </div>
          </li>
          <li>
            <span class="display how-num">02</span>
            <div>
              <h3>Get a tailored quote</h3>
              <p>We come back within 24 hours with a menu and price built around your event. No hidden extras.</p>
            </div>
          </li>
          <li>
            <span class="display how-num">03</span>
            <div>
              <h3>We turn up and feed people</h3>
              <p>Setup, service and clear-down all handled. You get to enjoy your own party.</p>
            </div>
          </li>
        </ol>
      </div>
      <div class="included">
        <h3 class="display included-title">Every booking includes</h3>
        <ul>
          <li>Friendly, experienced crew</li>
          <li>Our own power, unit and equipment</li>
          <li>Menu tailored to your guests</li>
          <li>Vegetarian &amp; vegan options</li>
          <li>Allergen info on request</li>
          <li>Setup and clear-down</li>
        </ul>
        <a href="#enquire" class="btn btn--primary">Get a Quote</a>
      </div>
    </div>
  </section>

  <!-- ===== MENU ===== -->
  <section class="section--sand section menu-teaser">
    <div class="container">
      <p class="eyebrow">The food</p>
      <h2 class="display section-title">Mix and match the menu</h2>
      <div class="menu-grid">
        <a href="/menu/#gyros" class="menu-card menu-card--photo">
          <img src="/image-assets/punters-couple-beers.webp" alt="A chicken gyros with tomato, chips and salad in a paper wrap" loading="lazy" width="600" height="800" />
          <div class="menu-card-overlay">
            <h3 class="display">Greek gyros</h3>
            <p>Chicken, pork or halloumi, loaded into warm flatbreads. Our heart and soul.</p>
          </div>
        </a>
        <a href="/menu/#korean" class="menu-card">
          <span class="menu-card-icon" aria-hidden="true">🍜</span>
          <h3 class="display">Korean bowls</h3>
          <p>Bold, punchy and fresh. Gochujang chicken, beef or tofu.</p>
        </a>
        <a href="/menu/#poke" class="menu-card">
          <span class="menu-card-icon" aria-hidden="true">🐟</span>
          <h3 class="display">Poke bowls</h3>
          <p>Lighter, brighter and built fresh. Salmon, tuna or vegan.</p>
        </a>
      </div>
      <p class="menu-note">Run one menu or combine them. <a href="/menu/">See the full menu →</a></p>
    </div>
  </section>

  <!-- ===== FESTIVALS (selective) ===== -->
  <section class="section--teal festival-banner">
    <div class="container festival-banner-inner">
      <div>
        <p class="eyebrow" style="color: rgba(255,255,255,0.65)">Still on the circuit</p>
        <h2 class="display festival-banner-headline">Catch us at a festival</h2>
        <p class="festival-banner-body">
          2026 took us from Cheltenham Jazz to Camp Bestival, Lakefest and 2000trees. Next year we're picking
          our favourite festivals and keeping more weekends free for private events.
        </p>
      </div>
      <a href="/festivals/" class="btn btn--outline">See Where We've Been</a>
    </div>
  </section>

  <!-- ===== GALLERY ===== -->
  <section class="section gallery-teaser">
    <div class="container">
      <p class="eyebrow">From the field</p>
      <h2 class="display section-title">See it in action</h2>
      <div class="gallery-teaser-grid">
        <div class="gallery-tile gallery-tile--wide">
          <img src="/image-assets/stall-twin-units.webp" alt="Castaway Kitchen's Greek gyros unit with a queue of hungry guests" loading="lazy" width="1100" height="825" />
        </div>
        <div class="gallery-tile">
          <img src="/image-assets/punters-crew-posing.webp" alt="A group of happy guests posing with their food" loading="lazy" width="1100" height="825" />
        </div>
        <div class="gallery-tile">
          <img src="/image-assets/stall-sunset-collect.webp" alt="Guests collecting food at the Castaway Kitchen unit at sunset" loading="lazy" width="1100" height="825" />
        </div>
        <div class="gallery-tile gallery-tile--wide">
          <img src="/image-assets/gallery-both-units.webp" alt="Castaway Kitchen's Greek and Korean units side by side" loading="lazy" width="900" height="675" />
        </div>
      </div>
      <div style="text-align: center; margin-top: var(--space-lg)">
        <a href="/gallery/" class="btn btn--outline-dark">View Gallery</a>
      </div>
    </div>
  </section>

  <!-- ===== ENQUIRY ===== -->
  <section class="section section--dark enquire" id="enquire">
    <div class="container enquire-inner">
      <div class="enquire-copy">
        <p class="eyebrow" style="color: var(--teal-light)">Get a quote</p>
        <h2 class="display enquire-title">Tell us about your event</h2>
        <p class="enquire-body">
          A few details and we'll come back within 24 hours with a tailored menu and price.
          No commitment, no hard sell.
        </p>
        <ul class="enquire-points">
          <li>Weddings, parties, corporate &amp; Christmas dos</li>
          <li>Cotswolds, Cornwall &amp; the South West</li>
          <li>Prefer email? <a href="mailto:hello@castawaykitchen.co.uk">hello@castawaykitchen.co.uk</a></li>
        </ul>
      </div>
      <div class="enquire-form-wrap">
        <EnquiryForm source="home" />
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section faq">
    <div class="container">
      <p class="eyebrow">Quick answers</p>
      <h2 class="display section-title">Common questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary class="faq-question"><span>{f.q}</span><span class="faq-icon" aria-hidden="true">+</span></summary>
            <p class="faq-answer" set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== LATEST FROM THE BLOG ===== -->
  {latestPosts.length > 0 && (
    <section class="section--sand section home-blog">
      <div class="container">
        <p class="eyebrow">Fresh off the grill</p>
        <h2 class="display section-title">Latest from the Blog</h2>
        <div class="home-blog-grid">
          {latestPosts.map(post => (
            <a href={`/blog/${post.slug}/`} class="home-blog-card">
              <div class="home-blog-card-image">
                <img src={post.data.image} alt={post.data.imageAlt} loading="lazy" width="600" height="400" />
                <span class="home-blog-card-tag">{post.data.tag}</span>
              </div>
              <div class="home-blog-card-body">
                <span class="home-blog-card-date">{formatDate(post.data.date)}</span>
                <h3 class="display home-blog-card-title">{post.data.title}</h3>
                <p class="home-blog-card-excerpt">{post.data.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
        <div style="text-align: center; margin-top: var(--space-lg)">
          <a href="/blog/" class="btn btn--outline-dark">Read the Blog</a>
        </div>
      </div>
    </section>
  )}

  <!-- Mobile sticky quote button -->
  <a href="#enquire" class="sticky-quote btn btn--primary" id="sticky-quote">Get a Quote</a>

  <script>
    // Show the mobile quote button only once the hero is out of view, and hide it at the form.
    const btn = document.getElementById('sticky-quote');
    const hero = document.querySelector('.hero');
    const form = document.getElementById('enquire');
    let heroVisible = true, formVisible = false;
    const update = () => btn?.classList.toggle('is-visible', !heroVisible && !formVisible);
    if (btn && hero && form && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => { heroVisible = e.isIntersecting; update(); }).observe(hero);
      new IntersectionObserver(([e]) => { formVisible = e.isIntersecting; update(); }).observe(form);
    }
  </script>

</BaseLayout>

<style>
  .section-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    margin: var(--space-sm) 0 var(--space-md);
  }

  .section-lede {
    font-size: var(--text-lg);
    color: var(--warm-grey);
    max-width: 620px;
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  /* ---- HERO ---- */
  .hero {
    position: relative;
    background:
      linear-gradient(100deg, rgba(13,13,13,0.94) 0%, rgba(13,13,13,0.8) 50%, rgba(13,13,13,0.45) 100%),
      url('/image-assets/stall-sunset-collect.webp') center 40% / cover no-repeat;
    background-color: var(--black);
    color: var(--white);
    min-height: calc(92vh - var(--nav-height));
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-xl);
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .hero-eyebrow { color: var(--teal-light); }

  .hero-headline {
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: 0.92;
    margin: var(--space-sm) 0 var(--space-md);
  }

  .hero-headline--teal { color: var(--teal-light); }

  .hero-body {
    font-size: var(--text-lg);
    color: rgba(255,255,255,0.78);
    max-width: 520px;
    margin-bottom: var(--space-lg);
    line-height: 1.7;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    font-weight: 700;
    color: rgba(255,255,255,0.7);
  }

  .hero-trust li::before {
    content: '✓';
    color: var(--teal-light);
    margin-right: 0.4rem;
    font-weight: 800;
  }

  .hero-badge img {
    filter: invert(1);
    opacity: 0;
  }

  .hero-logo-reveal { animation: logoAppear 1s ease-out 0.4s forwards; }

  @keyframes logoAppear {
    0%   { opacity: 0; transform: scale(0.92); }
    100% { opacity: 0.9; transform: scale(1); }
  }

  /* ---- BOOKING STRIP ---- */
  .booking-strip {
    background: var(--teal);
    color: var(--white);
    padding: 0.9rem 0;
  }

  .booking-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    font-size: var(--text-sm);
  }

  .booking-strip-link {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .booking-strip-link:hover { text-decoration: underline; }

  /* ---- EVENT TYPES ---- */
  .events-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .event-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 2px solid transparent;
    transition: transform 0.2s, border-color 0.2s;
  }

  .event-card:hover { transform: translateY(-4px); border-color: var(--teal); }

  .event-card-img { aspect-ratio: 4 / 3; overflow: hidden; }
  .event-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
  .event-card:hover .event-card-img img { transform: scale(1.05); }

  .event-card-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .event-card-title { font-size: var(--text-2xl); }

  .event-card-body p {
    font-size: var(--text-sm);
    color: var(--warm-grey);
    line-height: 1.6;
    flex: 1;
  }

  .event-card-link {
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--teal);
    margin-top: 0.25rem;
  }

  /* ---- PROOF ---- */
  .proof {
    position: relative;
    overflow: hidden;
    padding: var(--space-2xl) 0;
  }

  .proof-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
  }

  .proof-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .proof-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    color: var(--white);
    margin: var(--space-sm) 0 var(--space-md);
  }

  .proof-body {
    color: rgba(255,255,255,0.75);
    font-size: var(--text-lg);
    line-height: 1.7;
    max-width: 520px;
  }

  .proof-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .proof-stat {
    border-left: 3px solid var(--teal-light);
    padding-left: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .proof-num { font-size: var(--text-5xl); color: var(--teal-light); line-height: 1; }

  .proof-label {
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.6);
  }

  /* ---- HOW IT WORKS ---- */
  .how-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .how-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .how-steps li { display: flex; gap: var(--space-md); align-items: flex-start; }

  .how-num { font-size: var(--text-4xl); color: var(--teal); line-height: 1; width: 56px; flex-shrink: 0; }

  .how-steps h3 { font-size: var(--text-xl); font-weight: 800; margin-bottom: 4px; }
  .how-steps p { font-size: var(--text-base); color: var(--warm-grey); line-height: 1.6; }

  .included {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    border-top: 6px solid var(--teal);
  }

  .included-title { font-size: var(--text-3xl); margin-bottom: var(--space-md); }

  .included ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: var(--space-lg);
  }

  .included li { font-weight: 700; }
  .included li::before { content: '✓'; color: var(--teal); font-weight: 800; margin-right: 0.6rem; }

  /* ---- MENU ---- */
  .menu-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .menu-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    border: 2px solid transparent;
    transition: border-color 0.2s, transform 0.2s;
  }

  .menu-card:hover { border-color: var(--teal); transform: translateY(-3px); }
  .menu-card h3 { font-size: var(--text-3xl); }
  .menu-card p { color: var(--warm-grey); font-size: var(--text-sm); line-height: 1.6; }
  .menu-card-icon { font-size: 2.5rem; }

  .menu-card--photo {
    position: relative;
    padding: 0;
    overflow: hidden;
    min-height: 320px;
    justify-content: flex-end;
  }

  .menu-card--photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu-card-overlay {
    position: relative;
    padding: var(--space-lg);
