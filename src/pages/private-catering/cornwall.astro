---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Do you travel to Cornwall for events?',
    a: 'Yes — Cornwall is part of our regular operating area. We cover the full county from the Tamar to Land\'s End. Travel costs are factored into your quote transparently, so there are no surprises.',
  },
  {
    q: 'What areas of Cornwall do you cover?',
    a: 'We cover the full county — Truro, Falmouth, Newquay, St Ives, Penzance, Padstow, Rock, Fowey, Looe, Bodmin and everywhere in between. Scott, our founder, has strong personal ties to Cornwall and knows the county well.',
  },
  {
    q: 'What types of events do you cater for in Cornwall?',
    a: 'Private parties, birthday celebrations, wedding evening receptions, garden parties, outdoor events and corporate gatherings. Cornwall\'s outdoor event culture is a great fit for our festival-style setup.',
  },
  {
    q: 'Can you do wedding catering in Cornwall?',
    a: 'Yes. We\'re particularly well-suited to relaxed, outdoor and festival-style weddings — the kind Cornwall does so well. We can do evening food service, full reception catering, or both. Tell us what you\'re planning and we\'ll advise on the best approach.',
  },
  {
    q: 'How many guests can you cater for in Cornwall?',
    a: 'Comfortably from 30 guests up to several hundred. With two fully equipped units we can handle larger events without compromising on quality or speed of service.',
  },
  {
    q: 'Do you need a kitchen at the venue?',
    a: 'No — we\'re entirely self-sufficient. Our units carry their own equipment and power. We can operate in fields, on beaches (where permitted), in private gardens, at barn venues and marquee sites across Cornwall.',
  },
  {
    q: 'What makes Castaway Kitchen different from other Cornwall caterers?',
    a: 'Most catering in Cornwall is traditional — pasties, fish and chips, BBQ. We bring something genuinely different: authentic Greek gyros, Korean bowls and poke. Food that fits the relaxed, adventurous spirit of Cornwall perfectly — but that you won\'t find anywhere else at an event here.',
  },
  {
    q: 'Can you cater for dietary requirements?',
    a: 'Yes. Vegetarian and vegan options are available across all three menus. We take allergens seriously — let us know your requirements when you enquire and we\'ll make sure every guest is covered.',
  },
  {
    q: 'How far in advance should we book for a Cornwall event?',
    a: 'Summer in Cornwall books early — we\'d recommend getting in touch three to six months ahead for June through September events. We also have festival commitments in that period so availability is limited. Winter and spring events are more flexible. Drop us a message and we\'ll check availability.',
  },
  {
    q: 'How do I get a quote for a Cornwall event?',
    a: 'Use the contact form on this page or head to our main contact page. Give us your date, location in Cornwall, rough guest numbers and type of event and we\'ll come back to you within 24 hours.',
  },
];
---

<BaseLayout
  title="Street Food Catering Cornwall"
  description="Street food catering across Cornwall — Greek gyros, Korean bowls & poke for weddings, private parties & outdoor events. Scott lives in Cornwall. We know the county."
>

  <!-- HERO -->
  <section class="page-hero section--dark">
    <div class="container">
      <p class="eyebrow">Catering Cornwall</p>
      <h1 class="display page-hero-title">Street Food Catering<br />Across Cornwall</h1>
      <p class="page-hero-body">
        Greek gyros, Korean bowls and poke — brought to your event anywhere in Cornwall. Festival-quality food for private parties, weddings and outdoor events. Fully self-sufficient, no kitchen required.
      </p>
      <div class="hero-ctas">
        <a href="/contact" class="btn btn--primary">Get a Quote</a>
        <a href="/menu" class="btn btn--outline">See the Menu</a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="trust-bar section--teal">
    <div class="container trust-bar-inner">
      <div class="trust-item">
        <span class="display trust-num">2</span>
        <span class="trust-label">Fully Equipped Units</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="display trust-num">3</span>
        <span class="trust-label">Menus to Choose From</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="display trust-num">100%</span>
        <span class="trust-label">Self-Sufficient Setup</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="display trust-num">24hr</span>
        <span class="trust-label">Quote Turnaround</span>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="section why">
    <div class="container why-inner">
      <div class="why-text">
        <p class="eyebrow">Why Castaway Kitchen</p>
        <h2 class="display why-title">Cornwall is where Scott lives. Not just where we work.</h2>
        <p>Scott, Castaway Kitchen's founder, is Cotswolds born but Cornwall based. He didn't choose Cornwall as a market — he chose it as a place to live. That means he understands the county, its venues, its people and its events in a way that matters.</p>
        <p>Cornwall's outdoor event culture — cliff-top gardens, converted barns, private coves, festival fields — is exactly what Castaway Kitchen was built for. We're self-sufficient, we set up anywhere, and we've been doing it on the UK festival circuit for years.</p>
        <p>We bring Greek gyros — slow-cooked, properly loaded, made live in front of your guests — alongside Korean bowls, poke, and when the occasion calls for it, proper burgers too. Food with genuine character, that fits the relaxed spirit of Cornwall perfectly.</p>
        <a href="/contact" class="btn btn--primary" style="margin-top: var(--space-md)">Enquire Now</a>
      </div>
      <div class="why-features">
        <div class="why-feature">
          <span>🌊</span>
          <div>
            <strong>Built for outdoor Cornwall</strong>
            <p>Cliffs, coves, fields, gardens, barns — we're self-sufficient and set up anywhere.</p>
          </div>
        </div>
        <div class="why-feature">
          <span>⚡</span>
          <div>
            <strong>Fast service, no queues</strong>
            <p>Festival-trained. We serve efficiently at scale — no long waits at your event.</p>
          </div>
        </div>
        <div class="why-feature">
          <span>🌱</span>
          <div>
            <strong>Everyone's catered for</strong>
            <p>Vegetarian, vegan and allergen-aware options across all menus.</p>
          </div>
        </div>
        <div class="why-feature">
          <span>📋</span>
          <div>
            <strong>One supplier, zero hassle</strong>
            <p>We handle everything — setup, service, clearing. You focus on your guests.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MENU OPTIONS -->
  <section class="section--sand section menus">
    <div class="container">
      <p class="eyebrow">What we serve</p>
      <h2 class="display menus-title">Three menus. Mix and match.</h2>
      <p class="menus-intro">Run one menu or combine them — Greek gyros alongside Korean bowls, poke as a lighter option, or all three for a larger event. We tailor the setup to your guest numbers and event style.</p>

      <div class="menus-grid">
        <div class="menu-card menu-card--featured">
          <div class="menu-card-icon">🥙</div>
          <h3 class="display menu-card-title">Greek & Mediterranean</h3>
          <p>Our signature. Slow-cooked chicken or pork gyros, tzatziki, fresh flatbreads. Halloumi option available. The kind of food Cornwall's outdoor events were made for.</p>
          <a href="/menu#gyros" class="menu-card-link">See full menu →</a>
        </div>
        <div class="menu-card">
          <div class="menu-card-icon">🍜</div>
          <h3 class="display menu-card-title">Korean Bowls</h3>
          <p>Gochujang-glazed chicken or beef, steamed rice, pickled veg, kimchi. Bold flavours that stand out from anything else at a Cornwall event.</p>
          <a href="/menu#korean" class="menu-card-link">See full menu →</a>
        </div>
        <div class="menu-card">
          <div class="menu-card-icon">🐟</div>
          <h3 class="display menu-card-title">Poke Bowls</h3>
          <p>Fresh salmon or tuna poke, sushi rice, edamame, avocado. A light, fresh option that fits Cornwall's coastal character perfectly.</p>
          <a href="/menu#poke" class="menu-card-link">See full menu →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- EVENT TYPES -->
  <section class="section events">
    <div class="container">
      <p class="eyebrow">Events we cater</p>
      <h2 class="display events-title">Every occasion in Cornwall</h2>
      <div class="events-grid">
        <div class="event-card">
          <h3>🎉 Private Parties</h3>
          <p>Birthdays, garden parties, summer celebrations. Cornwall's outdoor lifestyle is a perfect backdrop for our setup — we turn up, feed people well, pack up and go.</p>
        </div>
        <div class="event-card">
          <h3>💍 Weddings</h3>
          <p>Evening food or full reception catering for Cornwall weddings. Festival-style food at a barn or clifftop venue — guests remember it. We work around your timeline and venue.</p>
        </div>
        <div class="event-card">
          <h3>💼 Corporate Events</h3>
          <p>Team events, client entertaining, away days. Proper food makes people feel valued. We make the catering a talking point, not an afterthought.</p>
        </div>
        <div class="event-card">
          <h3>🏕️ Outdoor & Festival Events</h3>
          <p>Cornwall's festival culture is our home ground. We're experienced outdoor traders who understand what it takes to run well in any conditions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LOCATIONS -->
  <section class="section--sand section locations">
    <div class="container">
      <p class="eyebrow">Where we cover</p>
      <h2 class="display locations-title">Across Cornwall</h2>
      <p class="locations-body">
        We cover the full county of Cornwall. Whether your event is in Truro, on the Roseland Peninsula, outside Newquay or down in Penzance, we can get there. Travel costs are included transparently in your quote.
      </p>
      <div class="locations-grid">
        <div class="location-col">
          <h3>Central Cornwall</h3>
          <ul>
            <li>Truro</li>
            <li>Bodmin</li>
            <li>St Austell</li>
            <li>Redruth</li>
            <li>Camborne</li>
            <li>Launceston</li>
          </ul>
        </div>
        <div class="location-col">
          <h3>North & West Cornwall</h3>
          <ul>
            <li>Newquay</li>
            <li>Padstow</li>
            <li>Rock</li>
            <li>St Ives</li>
            <li>Penzance</li>
            <li>Bude</li>
          </ul>
        </div>
        <div class="location-col">
          <h3>South Cornwall</h3>
          <ul>
            <li>Falmouth</li>
            <li>Fowey</li>
            <li>Looe</li>
            <li>Helston</li>
            <li>Roseland Peninsula</li>
            <li>Lizard Peninsula</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section how">
    <div class="container">
      <p class="eyebrow">The process</p>
      <h2 class="display how-title">How it works</h2>
      <div class="how-steps">
        <div class="how-step">
          <span class="display how-num">1</span>
          <div>
            <h3>Tell us about your Cornwall event</h3>
            <p>Date, location, guest numbers, type of event. Use the contact form or the main contact page. No commitment at this stage.</p>
          </div>
        </div>
        <div class="how-step">
          <span class="display how-num">2</span>
          <div>
            <h3>We send a tailored quote</h3>
            <p>Within 24 hours. Menu options, staffing, travel costs — all itemised clearly. No hidden extras.</p>
          </div>
        </div>
        <div class="how-step">
          <span class="display how-num">3</span>
          <div>
            <h3>We show up and deliver</h3>
            <p>On the day we handle everything from arrival to clear-up. Your guests get great food, you enjoy your event.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section--sand section faq">
    <div class="container">
      <p class="eyebrow">Common questions</p>
      <h2 class="display faq-title">Frequently asked questions</h2>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item" name="faq-cornwall">
            <summary class="faq-question">
              <span>{item.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section--dark section cta">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow">Ready to book?</p>
        <h2 class="display cta-title">Get a quote for your<br />Cornwall event</h2>
        <p class="cta-body">We respond within 24 hours. Tell us your date, location in Cornwall and rough guest numbers and we'll do the rest.</p>
      </div>
      <a href="/contact" class="btn btn--primary">Enquire Now</a>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  .page-hero-title {
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: var(--white);
    margin: var(--space-xs) 0 var(--space-md);
    line-height: 0.95;
  }

  .page-hero-body {
    font-size: var(--text-lg);
    color: rgba(255,255,255,0.7);
    max-width: 580px;
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .trust-bar { padding: var(--space-lg) 0; }

  .trust-bar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .trust-num {
    font-size: var(--text-4xl);
    color: var(--white);
    line-height: 1;
  }

  .trust-label {
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.7);
    text-align: center;
  }

  .trust-divider {
    width: 1px;
    height: 40px;
    background: rgba(255,255,255,0.25);
  }

  .why-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .why-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-md);
    line-height: 1;
  }

  .why-text p {
    font-size: var(--text-base);
    color: var(--warm-grey);
    line-height: 1.7;
    margin-bottom: var(--space-sm);
  }

  .why-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-top: var(--space-lg);
  }

  .why-feature {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .why-feature span { font-size: 1.75rem; flex-shrink: 0; }
  .why-feature strong { display: block; font-weight: 800; margin-bottom: 4px; }
  .why-feature p { font-size: var(--text-sm); color: var(--warm-grey); line-height: 1.6; }

  .menus-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-md);
  }

  .menus-intro {
    font-size: var(--text-lg);
    color: var(--warm-grey);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .menus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .menu-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .menu-card--featured { background: var(--teal); color: var(--white); }
  .menu-card-icon { font-size: 2rem; }
  .menu-card-title { font-size: var(--text-2xl); }
  .menu-card p { font-size: var(--text-sm); line-height: 1.7; opacity: 0.85; flex: 1; }
  .menu-card-link { font-size: var(--text-sm); font-weight: 800; color: var(--teal); margin-top: auto; }
  .menu-card--featured .menu-card-link { color: rgba(255,255,255,0.8); }

  .events-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-xl);
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .event-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .event-card h3 { font-size: var(--text-lg); font-weight: 800; margin-bottom: var(--space-sm); }
  .event-card p { font-size: var(--text-sm); color: var(--warm-grey); line-height: 1.7; }

  .locations-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-md);
  }

  .locations-body {
    font-size: var(--text-lg);
    color: var(--warm-grey);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .locations-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .location-col h3 {
    font-weight: 800;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--teal-dark);
    margin-bottom: var(--space-sm);
  }

  .location-col ul { display: flex; flex-direction: column; gap: 8px; }

  .location-col li {
    font-size: var(--text-sm);
    color: var(--warm-grey);
    padding-left: var(--space-sm);
    border-left: 2px solid var(--teal-light);
  }

  .how-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-xl);
  }

  .how-steps { display: flex; flex-direction: column; gap: var(--space-lg); max-width: 640px; }

  .how-step { display: flex; gap: var(--space-lg); align-items: flex-start; }

  .how-num {
    font-size: var(--text-5xl);
    color: var(--teal);
    line-height: 1;
    flex-shrink: 0;
    width: 48px;
  }

  .how-step h3 { font-size: var(--text-xl); font-weight: 800; margin-bottom: 6px; }
  .how-step p { font-size: var(--text-sm); color: var(--warm-grey); line-height: 1.7; }

  .faq-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-xl);
  }

  .faq-list { max-width: 800px; display: flex; flex-direction: column; gap: 2px; }

  .faq-item { background: var(--white); border-radius: var(--radius-md); overflow: hidden; }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    cursor: pointer;
    font-weight: 800;
    font-size: var(--text-base);
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker { display: none; }
  .faq-icon { font-size: var(--text-xl); font-weight: 400; color: var(--teal); flex-shrink: 0; transition: transform 0.2s; }
  .faq-item[open] .faq-icon { transform: rotate(45deg); }
  .faq-answer { padding: 0 var(--space-lg) var(--space-md); font-size: var(--text-sm); color: var(--warm-grey); line-height: 1.7; }

  .cta { padding: var(--space-xl) 0; }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .cta-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: var(--white);
    margin: var(--space-xs) 0 var(--space-sm);
    line-height: 1;
  }

  .cta-body { color: rgba(255,255,255,0.7); font-size: var(--text-base); max-width: 480px; line-height: 1.7; }

  @media (max-width: 900px) {
    .why-inner { grid-template-columns: 1fr; }
    .menus-grid { grid-template-columns: 1fr; }
    .events-grid { grid-template-columns: 1fr 1fr; }
    .locations-grid { grid-template-columns: 1fr 1fr; }
    .trust-bar-inner { gap: var(--space-lg); }
    .trust-divider { display: none; }
    .cta-inner { flex-direction: column; align-items: flex-start; }
  }

  @media (max-width: 600px) {
    .events-grid { grid-template-columns: 1fr; }
    .locations-grid { grid-template-columns: 1fr; }
  }
</style>