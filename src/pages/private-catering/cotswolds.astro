---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Where exactly in the Cotswolds do you cover?',
    a: 'We cover the full Cotswolds area — Cheltenham, Cirencester, Bourton-on-the-Water, Chipping Campden, Stow-on-the-Wold, Moreton-in-Marsh, Burford, Tetbury, Stroud and everywhere in between. We\'re based in Moreton-in-Marsh so we know this area well.',
  },
  {
    q: 'What type of events do you cater for in the Cotswolds?',
    a: 'Private parties, birthday celebrations, anniversary dinners, wedding evening receptions, corporate away days, garden parties and marquee events. If you\'re feeding a crowd in the Cotswolds and want something different from the standard buffet, we\'re the call to make.',
  },
  {
    q: 'How many guests can you cater for?',
    a: 'We comfortably cater from 30 guests up to several hundred. With two fully equipped units we can run larger events without compromising on speed or quality. Tell us your guest numbers and we\'ll advise on the right setup.',
  },
  {
    q: 'Do you work with Cotswolds venues and barns?',
    a: 'Yes — we\'re fully self-sufficient with our own power and equipment, so we can operate at barn venues, private estates, marquees and open fields without needing an on-site kitchen. We\'ve catered at venues across the Cotswolds and understand what the area\'s event spaces need.',
  },
  {
    q: 'What makes Castaway Kitchen different from other Cotswolds caterers?',
    a: 'Most catering in the Cotswolds is traditional — hog roasts, paella, buffets. We bring something genuinely different: Greek gyros, Korean bowls and poke, cooked live in front of your guests. But the bigger difference is that Scott, our founder, grew up in Chipping Campden and went to school there. We\'ve traded at Cheltenham Jazz Festival, worked at Sandford Lido in Cheltenham, and have genuine roots in the area going back years. We\'re not a national company targeting the Cotswolds as a postcode. This is home ground.',
  },
  {
    q: 'Can you do a bespoke menu for our event?',
    a: 'Absolutely. We can run one cuisine or combine them — Greek alongside Korean, or poke as a lighter option alongside gyros. We\'ll work with you on dietary requirements, portion sizes and service style to fit your event.',
  },
  {
    q: 'How far in advance should we book?',
    a: 'For summer events in the Cotswolds — particularly June through September — we\'d recommend getting in touch at least three months ahead. We book up quickly during festival season. Winter and early spring events often have more flexibility. Drop us a message and we\'ll check availability.',
  },
  {
    q: 'What\'s included in your catering package?',
    a: 'Everything. We bring our own equipment, staff, serving setup and clear away at the end. You don\'t need to worry about hiring additional equipment or coordinating with multiple suppliers. One call, fully sorted.',
  },
  {
    q: 'Do you cater for dietary requirements?',
    a: 'Yes — vegetarian, vegan and gluten-aware options are available across all three menus. We take allergen queries seriously. Please let us know your guests\' requirements when you enquire and we\'ll make sure nobody misses out.',
  },
  {
    q: 'How do I get a quote?',
    a: 'Use the contact form on this page or head to our main contact page. Give us your date, location, rough guest numbers and type of event and we\'ll come back to you within 24 hours with a tailored quote.',
  },
];
---

<BaseLayout
  title="Event Catering Cotswolds"
  description="Bespoke event catering across the Cotswolds & Gloucestershire. Scott grew up in Chipping Campden — this is home ground. Menus tailored to your event, your guests, your venue."
>

  <!-- HERO -->
  <section class="page-hero section--dark">
    <div class="container">
      <p class="eyebrow">Catering Cotswolds</p>
      <h1 class="display page-hero-title">Event Catering<br />Cotswolds</h1>
      <p class="page-hero-body">
        Distinctive, properly executed catering for events across the Cotswolds and Gloucestershire. Bespoke menus, fully staffed, fully self-sufficient. Built around your event — not the other way around.
      </p>
      <div class="hero-ctas">
        <a href="/contact" class="btn btn--primary">Get a Quote</a>
        <a href="/menu" class="btn btn--outline">See the Menu</a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="trust-bar section--teal">
    <div class="container trust-bar-inner">
      <div class="trust-item">
        <span class="display trust-num">2</span>
        <span class="trust-label">Fully Equipped Units</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="display trust-num">3</span>
        <span class="trust-label">Menus to Choose From</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="display trust-num">100%</span>
        <span class="trust-label">Self-Sufficient Setup</span>
      </div>
      <div class="trust-divider"></div>
      <div class="trust-item">
        <span class="display trust-num">24hr</span>
        <span class="trust-label">Quote Turnaround</span>
      </div>
    </div>
  </section>

  <!-- LOCAL CREDENTIALS -->
  <section class="section credentials">
    <div class="container">
      <p class="eyebrow">Our Cotswolds roots</p>
      <h2 class="display credentials-title">Not passing through. From here.</h2>
      <div class="credentials-grid">
        <div class="credential">
          <span class="credential-icon">🏫</span>
          <div>
            <strong>Chipping Campden</strong>
            <p>Scott, Castaway Kitchen's founder, grew up in Chipping Campden and went to school there. The Cotswolds isn't a market — it's home.</p>
          </div>
        </div>
        <div class="credential">
          <span class="credential-icon">🎷</span>
          <div>
            <strong>Cheltenham Jazz Festival</strong>
            <p>We've traded at one of the UK's best-loved festivals, right in the heart of Cheltenham. We know the area's event circuit intimately.</p>
          </div>
        </div>
        <div class="credential">
          <span class="credential-icon">🏊</span>
          <div>
            <strong>Sandford Lido, Cheltenham</strong>
            <p>We've served at Sandford Parks Lido — a Cheltenham institution. Local venues, local crowds, local knowledge.</p>
          </div>
        </div>
        <div class="credential">
          <span class="credential-icon">🎪</span>
          <div>
            <strong>Festival circuit veterans</strong>
            <p>Years of trading at UK festivals — Lakefest, 2000 Trees and more. We bring that experience and efficiency to every private event.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY DIFFERENT -->
  <section class="section why">
    <div class="container why-inner">
      <div class="why-text">
        <p class="eyebrow">Why Castaway Kitchen</p>
        <h2 class="display why-title">Cotswolds born. Genuinely local. Completely adaptable.</h2>
        <p>Scott, who founded Castaway Kitchen, grew up in Chipping Campden and went to school there. The Cotswolds isn't a territory we've decided to target — it's home. That means we understand the venues, the clientele and the standard expected at events in this area.</p>
        <p>We've traded at Cheltenham Jazz Festival, worked at Sandford Lido, and catered events across Gloucestershire long before this website existed. We're not parachuting in from elsewhere and hoping for the best.</p>
        <p>Our menus are built around bold, fresh cooking — Mediterranean, Korean and beyond — but we're not rigidly attached to a single cuisine. For the right event we'll work with you to build something that fits your guests, your venue and your brief. Bespoke is not a word we use lightly.</p>
        <a href="/contact" class="btn btn--primary" style="margin-top: var(--space-md)">Discuss Your Event</a>
      </div>
      <div class="why-features">
        <div class="why-feature">
          <span>⚡</span>
          <div>
            <strong>Fast service, no queues</strong>
            <p>Festival-trained. We serve efficiently even at scale — no long waits at your event.</p>
          </div>
        </div>
        <div class="why-feature">
          <span>🏡</span>
          <div>
            <strong>Works anywhere in the Cotswolds</strong>
            <p>Fully self-sufficient — no on-site kitchen needed. Private estates, barns, marquees, fields.</p>
          </div>
        </div>
        <div class="why-feature">
          <span>🌱</span>
          <div>
            <strong>Everyone's catered for</strong>
            <p>Vegetarian, vegan and allergen-aware options across all menus. Nobody left out.</p>
          </div>
        </div>
        <div class="why-feature">
          <span>📋</span>
          <div>
            <strong>One supplier, zero hassle</strong>
            <p>We handle everything — setup, service, clearing. You focus on your guests.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MENU OPTIONS -->
  <section class="section--sand section menus">
    <div class="container">
      <p class="eyebrow">What we serve</p>
      <h2 class="display menus-title">Bold cooking. Built around your event.</h2>
      <p class="menus-intro">Our core menus draw on Mediterranean, Korean and Japanese influences — fresh, distinctive and genuinely different from standard event catering. For bespoke requirements, we're happy to discuss options that fit your brief.</p>

      <div class="menus-grid">
        <div class="menu-card menu-card--featured">
          <div class="menu-card-icon">🥙</div>
          <h3 class="display menu-card-title">Greek & Mediterranean</h3>
          <p>Our signature. Slow-cooked chicken or pork gyros, tzatziki, fresh flatbreads. Halloumi option available. The Cotswolds crowd consistently goes back for seconds.</p>
          <a href="/menu#gyros" class="menu-card-link">See full menu →</a>
        </div>
        <div class="menu-card">
          <div class="menu-card-icon">🍜</div>
          <h3 class="display menu-card-title">Korean Bowls</h3>
          <p>Gochujang-glazed chicken or beef, steamed rice, pickled veg, kimchi. Bold, fresh and genuinely different from anything else you'll find at a Cotswolds event.</p>
          <a href="/menu#korean" class="menu-card-link">See full menu →</a>
        </div>
        <div class="menu-card">
          <div class="menu-card-icon">🐟</div>
          <h3 class="display menu-card-title">Poke Bowls</h3>
          <p>Fresh salmon or tuna poke, sushi rice, edamame, avocado, sesame dressing. A lighter option that works brilliantly as a summer starter or standalone menu.</p>
          <a href="/menu#poke" class="menu-card-link">See full menu →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- EVENT TYPES -->
  <section class="section events">
    <div class="container">
      <p class="eyebrow">Events we cater</p>
      <h2 class="display events-title">Every occasion in the Cotswolds</h2>
      <div class="events-grid">
        <div class="event-card">
          <h3>🎉 Private Parties</h3>
          <p>Birthdays, anniversaries, garden parties, summer celebrations. We turn up, feed people well, and leave you free to actually enjoy your own event.</p>
        </div>
        <div class="event-card">
          <h3>💍 Wedding Receptions</h3>
          <p>Evening food or full reception catering. Festival-style at a Cotswolds barn hits differently — guests love it. We fit around your venue and timeline.</p>
        </div>
        <div class="event-card">
          <h3>💼 Corporate Events</h3>
          <p>Away days, team lunches, client entertaining. Proper food makes a difference to how people feel about the day. We make the catering a highlight, not an afterthought.</p>
        </div>
        <div class="event-card">
          <h3>🏡 Marquee & Estate Events</h3>
          <p>No kitchen? No problem. We're entirely self-sufficient. Private estates and marquee events across the Cotswolds are our territory.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LOCATIONS -->
  <section class="section--sand section locations">
    <div class="container">
      <p class="eyebrow">Where we cover</p>
      <h2 class="display locations-title">Across the Cotswolds & Gloucestershire</h2>
      <p class="locations-body">
        Based in Moreton-in-Marsh, we cover the full Cotswolds area and wider Gloucestershire. From Cheltenham to Cirencester, Chipping Campden to Burford — if your event is in the Cotswolds, we can be there.
      </p>
      <div class="locations-grid">
        <div class="location-col">
          <h3>Gloucestershire</h3>
          <ul>
            <li>Cheltenham</li>
            <li>Gloucester</li>
            <li>Stroud</li>
            <li>Cirencester</li>
            <li>Tewkesbury</li>
            <li>Moreton-in-Marsh</li>
          </ul>
        </div>
        <div class="location-col">
          <h3>Cotswolds Villages</h3>
          <ul>
            <li>Bourton-on-the-Water</li>
            <li>Chipping Campden</li>
            <li>Stow-on-the-Wold</li>
            <li>Burford</li>
            <li>Tetbury</li>
            <li>Northleach</li>
          </ul>
        </div>
        <div class="location-col">
          <h3>Wider Area</h3>
          <ul>
            <li>Oxfordshire</li>
            <li>Worcestershire</li>
            <li>Warwickshire</li>
            <li>Bristol</li>
            <li>Bath</li>
            <li>South West broadly</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section how">
    <div class="container">
      <p class="eyebrow">The process</p>
      <h2 class="display how-title">How it works</h2>
      <div class="how-steps">
        <div class="how-step">
          <span class="display how-num">1</span>
          <div>
            <h3>Tell us about your event</h3>
            <p>Date, location in the Cotswolds, guest numbers, type of event. Use the form below or the contact page. No commitment at this stage.</p>
          </div>
        </div>
        <div class="how-step">
          <span class="display how-num">2</span>
          <div>
            <h3>We send a tailored quote</h3>
            <p>Within 24 hours. Menu options, staffing, setup — all itemised clearly. No hidden extras.</p>
          </div>
        </div>
        <div class="how-step">
          <span class="display how-num">3</span>
          <div>
            <h3>We show up and deliver</h3>
            <p>On the day we handle everything from arrival to clear-up. Your guests get great food, you get to enjoy your event.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section--sand section faq">
    <div class="container">
      <p class="eyebrow">Common questions</p>
      <h2 class="display faq-title">Frequently asked questions</h2>
      <div class="faq-list">
        {faqs.map((item, i) => (
          <details class="faq-item" name="faq">
            <summary class="faq-question">
              <span>{item.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section--dark section cta">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow">Ready to book?</p>
        <h2 class="display cta-title">Get a quote for your<br />Cotswolds event</h2>
        <p class="cta-body">We respond within 24 hours. Tell us your date, location and rough guest numbers and we'll do the rest.</p>
      </div>
      <a href="/contact" class="btn btn--primary">Enquire Now</a>
    </div>
  </section>

</BaseLayout>

<style>
  .page-hero {
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  .page-hero-title {
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: var(--white);
    margin: var(--space-xs) 0 var(--space-md);
    line-height: 0.95;
  }

  .page-hero-body {
    font-size: var(--text-lg);
    color: rgba(255,255,255,0.7);
    max-width: 580px;
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* TRUST BAR */
  .trust-bar {
    padding: var(--space-lg) 0;
  }

  .trust-bar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .trust-num {
    font-size: var(--text-4xl);
    color: var(--white);
    line-height: 1;
  }

  .trust-label {
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.7);
    text-align: center;
  }

  .trust-divider {
    width: 1px;
    height: 40px;
    background: rgba(255,255,255,0.25);
  }

  /* CREDENTIALS */
  .credentials-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-xl);
  }

  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .credential {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    border-left: 4px solid var(--teal);
  }

  .credential-icon {
    font-size: 2rem;
  }

  .credential strong {
    display: block;
    font-weight: 800;
    font-size: var(--text-base);
    margin-bottom: 4px;
  }

  .credential p {
    font-size: var(--text-sm);
    color: var(--warm-grey);
    line-height: 1.6;
  }

  /* WHY */
  .why-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .why-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-md);
    line-height: 1;
  }

  .why-text p {
    font-size: var(--text-base);
    color: var(--warm-grey);
    line-height: 1.7;
    margin-bottom: var(--space-sm);
  }

  .why-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-top: var(--space-lg);
  }

  .why-feature {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .why-feature span {
    font-size: 1.75rem;
    flex-shrink: 0;
  }

  .why-feature strong {
    display: block;
    font-weight: 800;
    margin-bottom: 4px;
  }

  .why-feature p {
    font-size: var(--text-sm);
    color: var(--warm-grey);
    line-height: 1.6;
  }

  /* MENUS */
  .menus-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-md);
  }

  .menus-intro {
    font-size: var(--text-lg);
    color: var(--warm-grey);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .menus-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .menu-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .menu-card--featured {
    background: var(--teal);
    color: var(--white);
  }

  .menu-card-icon {
    font-size: 2rem;
  }

  .menu-card-title {
    font-size: var(--text-2xl);
  }

  .menu-card p {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: inherit;
    opacity: 0.85;
    flex: 1;
  }

  .menu-card-link {
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--teal);
    margin-top: auto;
  }

  .menu-card--featured .menu-card-link {
    color: rgba(255,255,255,0.8);
  }

  /* EVENTS */
  .events-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-xl);
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .event-card {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .event-card h3 {
    font-size: var(--text-lg);
    font-weight: 800;
    margin-bottom: var(--space-sm);
  }

  .event-card p {
    font-size: var(--text-sm);
    color: var(--warm-grey);
    line-height: 1.7;
  }

  /* LOCATIONS */
  .locations-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-md);
  }

  .locations-body {
    font-size: var(--text-lg);
    color: var(--warm-grey);
    max-width: 600px;
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .locations-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .location-col h3 {
    font-weight: 800;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--teal-dark);
    margin-bottom: var(--space-sm);
  }

  .location-col ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .location-col li {
    font-size: var(--text-sm);
    color: var(--warm-grey);
    padding-left: var(--space-sm);
    border-left: 2px solid var(--teal-light);
  }

  /* HOW */
  .how-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-xl);
  }

  .how-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 640px;
  }

  .how-step {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
  }

  .how-num {
    font-size: var(--text-5xl);
    color: var(--teal);
    line-height: 1;
    flex-shrink: 0;
    width: 48px;
  }

  .how-step h3 {
    font-size: var(--text-xl);
    font-weight: 800;
    margin-bottom: 6px;
  }

  .how-step p {
    font-size: var(--text-sm);
    color: var(--warm-grey);
    line-height: 1.7;
  }

  /* FAQ */
  .faq-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin: var(--space-xs) 0 var(--space-xl);
  }

  .faq-list {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .faq-item {
    background: var(--white);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    cursor: pointer;
    font-weight: 800;
    font-size: var(--text-base);
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--teal);
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 var(--space-lg) var(--space-md);
    font-size: var(--text-sm);
