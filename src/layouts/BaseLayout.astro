---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  schema?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'Castaway Kitchen — Festival street food done properly. Greek gyros, Korean bowls & more. Available for festivals and private catering across the UK.',
  ogImage = '/castaway-logo.png',
  schema = false,
  noindex = false,
} = Astro.props;

// Canonical URL: always https://castawaykitchen.co.uk with a trailing slash
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();

// Floating WhatsApp button: add Scott's WhatsApp Business number here (format 447xxxxxxxxx).
// Left blank, the button stays hidden so visitors never hit a dead number.
const WHATSAPP_NUMBER = '';

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FoodEstablishment',
  name: 'Castaway Kitchen',
  description: 'Festival street food caterer for private events, weddings, parties and corporate events. Greek gyros, Korean bowls and poke.',
  url: 'https://castawaykitchen.co.uk/',
  logo: 'https://castawaykitchen.co.uk/castaway-logo.png',
  image: 'https://castawaykitchen.co.uk/image-assets/stall-sunset-collect.webp',
  email: 'hello@castawaykitchen.co.uk',
  servesCuisine: ['Greek', 'Mediterranean', 'Korean', 'Poke'],
  address: { '@type': 'PostalAddress', addressLocality: 'Moreton-in-Marsh', addressRegion: 'Gloucestershire', addressCountry: 'GB' },
  areaServed: ['Cotswolds', 'Gloucestershire', 'Oxfordshire', 'Cornwall', 'Devon', 'Bristol', 'South West England'],
  sameAs: ['https://www.instagram.com/castawaykitchen/', 'https://www.facebook.com/CastawayKitchen'],
};

const fullTitle = title === 'Home'
  ? 'Private Event & Wedding Catering | Festival Street Food | Castaway Kitchen'
  : title === 'About'
  ? 'About Castaway Kitchen | Festival Catering & Street Food Since 2015'
  : title === 'Food & Menu'
  ? 'Greek Gyros, Korean Bowls & Poke | Festival Street Food Menu | Castaway Kitchen'
  : title === 'Festivals'
  ? 'Festival Street Food | Lakefest, 2000trees, Camp Bestival & More | Castaway Kitchen'
  : title === 'Private Catering'
  ? 'Private Event Catering | Weddings, Parties & Corporate | Castaway Kitchen'
  : title === 'Gallery'
  ? 'Festival Food Van Photos | Castaway Kitchen'
  : title === 'Contact'
  ? 'Get a Catering Quote | Castaway Kitchen | Cotswolds & South West'
  : title === 'Event Catering Cotswolds'
  ? 'Event Catering Cotswolds | Bespoke Menus for Private Events | Castaway Kitchen'
  : title === 'Street Food Catering Cornwall'
  ? 'Street Food Catering Cornwall | Private Events & Weddings | Castaway Kitchen'
  : `${title} | Castaway Kitchen`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Castaway Kitchen" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/castaway-logo.png" />
    <title>{fullTitle}</title>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />}
  </head>
  <body>
  {WHATSAPP_NUMBER && (
  <a
  href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hi%20Castaway%20Kitchen%2C%20I%27d%20like%20to%20enquire%20about%20catering`}
  class="whatsapp-btn" 
  target="_blank" 
  rel="noopener"
  aria-label="Chat on WhatsApp"
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
</a>
  )}

<style>
  .whatsapp-btn {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 56px;
    height: 56px;
    background: #25D366;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 999;
    box-shadow: 0 4px 12px rgba(37,211,102,0.4);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .whatsapp-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(37,211,102,0.5);
  }
</style>
    <Nav />
    <main style={`padding-top: var(--nav-height);`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>