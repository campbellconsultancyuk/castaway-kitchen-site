/* ---- SVG ambient loops (cheap, transform-only) ---- */
.ck-cloud { animation: ck-cloud-drift linear infinite; }
.ck-cloud-1 { animation-duration: 90s; }
.ck-cloud-2 { animation-duration: 130s; animation-delay: -40s; }
.ck-cloud-3 { animation-duration: 110s; animation-delay: -70s; }
@keyframes ck-cloud-drift {
  from { transform: translateX(-120px); }
  to   { transform: translateX(1720px); }
}
.ck-steam-puff { animation: ck-steam 3.4s ease-out infinite; opacity: 0; }
.ck-steam-puff.s2 { animation-delay: 1.1s; }
.ck-steam-puff.s3 { animation-delay: 2.2s; }
@keyframes ck-steam {
  0%   { transform: translateY(0) scale(.7); opacity: 0; }
  20%  { opacity: .55; }
