---
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/castaway-logo.png" alt="Castaway Kitchen" width="64" height="64" class="footer-logo" />
      <p class="footer-tagline">Festival street food done properly.<br />Greek, Korean &amp; beyond.</p>
      <a href="https://www.ncass.org.uk/" target="_blank" rel="noopener" class="footer-ncass" aria-label="NCASS — Nationwide Caterers Association">
        <img src="/ncass-logo.png" alt="NCASS — Nationwide Caterers Association member" width="150" height="79" />
      </a>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="/">Home</a>
      <a href="/menu">Food &amp; Menu</a>
      <a href="/festivals">Festivals</a>
      <a href="/private-catering">Private Catering</a>
      <a href="/gallery">Gallery</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>

    <div class="footer-contact">
      <p class="eyebrow">Get in touch</p>
      <a href="mailto:hello@castawaykitchen.co.uk">hello@castawaykitchen.co.uk</a>
      <div class="footer-social">
        <a href="https://www.instagram.com/castawaykitchen/" target="_blank" rel="noopener" aria-label="Instagram" class="social-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/CastawayKitchen" target="_blank" rel="noopener" aria-label="Facebook" class="social-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
        <a href="https://x.com/jeveready" target="_blank" rel="noopener" aria-label="X (formerly Twitter)" class="social-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>© {new Date().getFullYear()} Castaway Kitchen. All rights reserved.</p>
      <p>Site by <a href="https://campbellconsultancy.co" target="_blank" rel="noopener">Campbell Consultancy</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--black);
    color: rgba(255,255,255,0.7);
    padding-top: var(--space-2xl);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .footer-logo {
    filter: invert(1);
    margin-bottom: var(--space-sm);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: rgba(255,255,255,0.5);
  }

  .footer-ncass {
    display: inline-block;
    margin-top: var(--space-md);
    border-radius: var(--radius-sm);
    opacity: 0.92;
    transition: opacity 0.2s, transform 0.2s;
  }

  .footer-ncass img {
    width: 150px;
    height: auto;
  }

  .footer-ncass:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-nav a {
    font-size: var(--text-sm);
    font-weight: 600;
    color: rgba(255,255,255,0.6);
    transition: color 0.2s;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .footer-nav a:hover {
    color: var(--teal-light);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-contact a {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.6);
    transition: color 0.2s;
  }

  .footer-contact a:hover {
    color: var(--white);
  }

  .footer-social {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.6);
    transition: all 0.2s;
  }

  .social-link:hover {
    border-color: var(--teal-light);
    color: var(--teal-light);
  }

  .footer-bottom {
    padding: var(--space-md) 0;
  }

  .footer-bottom .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .footer-bottom p {
    font-size: var(--text-xs);
    color: rgba(255,255,255,0.3);
  }

  .footer-bottom a {
    color: rgba(255,255,255,0.5);
    transition: color 0.2s;
  }

  .footer-bottom a:hover {
    color: var(--teal-light);
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .footer-bottom .container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>