---
const festivals = [
  {
    id: 'cheltenham-jazz',
    num: 1,
    name: 'Cheltenham Jazz Festival',
    dates: '28 Apr – 5 May',
    location: 'Cheltenham, Gloucestershire',
    status: 'completed',
    desc: 'Our home patch. Scott grew up in Chipping Campden — Cheltenham Jazz is where the season begins.',
    url: 'https://www.cheltenhamfestivals.com/jazz',
    x: 53.2, y: 51.9,
    gyros: 280, miles: 0,
  },
  {
    id: 'big-retreat',
    num: 2,
    name: 'The Big Retreat Festival',
    dates: '21 – 26 May',
    location: 'Lawrenny, Pembrokeshire',
    status: 'completed',
    desc: 'Wellness, music and good vibes on the Pembrokeshire coast. A different crowd, a brilliant atmosphere.',
    url: 'https://www.thebigretreatfestival.com/',
    x: 24.5, y: 44.8,
    gyros: 320, miles: 180,
  },
  {
    id: '2000trees',
    num: 3,
    name: '2000trees Festival',
    dates: '7 – 12 Jul',
    location: 'Upcote Farm, Cheltenham',
    status: 'current',
    desc: 'Consistently one of the best-run festivals in the UK. Indie, alternative, and we\'re proud to be part of it.',
    url: 'https://2000trees.co.uk/',
    x: 53.2, y: 49.5,
    gyros: 450, miles: 8,
  },
  {
    id: 'emf',
    num: 4,
    name: 'Electromagnetic Field',
    dates: '16 – 19 Jul',
    location: 'Eastnor Castle Deer Park, Herefordshire',
    status: 'upcoming',
    desc: 'Tech, art and making. A unique crowd who appreciate proper food as much as a good hack.',
    url: 'https://www.emfcamp.org/',
    x: 49.8, y: 50.2,
    gyros: 310, miles: 12,
  },
  {
    id: 'camp-bestival',
    num: 5,
    name: 'Camp Bestival',
    dates: '29 Jul – 3 Aug',
    location: 'Lulworth Castle, Dorset',
    status: 'upcoming',
    desc: 'Family festival at a stunning Dorset castle. Big crowds, brilliant energy, and gyros going fast.',
    url: 'https://dorset.campbestival.net/',
    x: 49.2, y: 65.5,
    gyros: 520, miles: 95,
  },
  {
    id: 'lakefest',
    num: 6,
    name: 'Lakefest',
    dates: '4 – 10 Aug',
    location: 'Eastnor Castle Deer Park, Herefordshire',
    status: 'upcoming',
    desc: 'Lakeside vibes, brilliant crowd, and a pitch right in the heart of the action. One of our favourites.',
    url: 'https://www.lakefest.co.uk/',
    x: 49.8, y: 51.0,
    gyros: 480, miles: 12,
  },
  {
    id: 'beautiful-days',
    num: 7,
    name: 'Beautiful Days',
    dates: '20 – 24 Aug',
    location: 'Escot Park, Devon',
    status: 'upcoming',
    desc: 'An institution. Beautiful setting, loyal crowd, and Cornwall just down the road.',
    url: 'https://www.beautifuldays.org/',
    x: 33.5, y: 68.2,
    gyros: 390, miles: 145,
  },
  {
    id: 'forwards',
    num: 8,
    name: 'Forwards Festival',
    dates: '26 – 31 Aug',
    location: 'Bristol',
    status: 'upcoming',
    desc: 'Bristol\'s biggest music festival. Urban, diverse and seriously good fun.',
    url: 'https://www.forwardsbristol.co.uk/',
    x: 47.5, y: 58.8,
    gyros: 420, miles: 55,
  },
  {
    id: 'we-have-ways',
    num: 9,
    name: 'We Have Ways Festival',
    dates: '10 – 14 Sep',
    location: 'Blackpit Farm, Buckinghamshire',
    status: 'upcoming',
    desc: 'History, music and community in the Buckinghamshire countryside. Season finale vibes.',
    url: 'https://wehavewaysfest.co.uk/',
    x: 62.5, y: 47.8,
    gyros: 360, miles: 82,
  },
];

const nextFestival = festivals.find(f => f.status === 'current') || festivals.find(f => f.status === 'upcoming');
const completedCount = festivals.filter(f => f.status === 'completed').length;
---

<div class="roadmap-wrap">

  <!-- NEXT FESTIVAL BANNER -->
  <div class="next-banner">
    <div class="next-banner-inner">
      <div class="next-left">
        <span class="eyebrow next-eyebrow">Next up</span>
        <h2 class="display next-name">{nextFestival?.name}</h2>
        <p class="next-meta">📅 {nextFestival?.dates} &nbsp;·&nbsp; 📍 {nextFestival?.location}</p>
      </div>
      <div class="next-right">
        <div class="countdown-wrap">
          <span class="display countdown-num" id="countdown-days">--</span>
          <span class="countdown-label">Days to go</span>
        </div>
      </div>
    </div>
  </div>

  <!-- MAP + PANEL -->
  <div class="map-panel-grid">

    <!-- SVG MAP -->
    <div class="map-container">
      <svg id="festival-map" viewBox="0 0 400 520" xmlns="http://www.w3.org/2000/svg" aria-label="UK festival map">

        <!-- UK outline path - simplified but accurate -->
        <g id="uk-land" fill="#1a2a28" stroke="#2a7c6f" stroke-width="1" opacity="0.9">
          <!-- England, Scotland, Wales simplified -->
          <path d="
            M 200,28 L 205,32 L 212,30 L 218,35 L 215,42 L 220,48 L 218,55
            L 224,60 L 228,68 L 222,74 L 226,80 L 230,88 L 226,95
            L 232,100 L 235,108 L 230,115 L 235,122 L 238,130
            L 232,136 L 228,144 L 232,150 L 228,158 L 224,165
            L 228,172 L 232,180 L 226,186 L 222,194
            L 218,200 L 222,208 L 226,215 L 220,220
            L 215,228 L 218,236 L 214,242 L 210,248
            L 205,255 L 208,262 L 212,270 L 208,276
            L 204,282 L 200,290 L 196,296 L 192,302
            L 188,308 L 184,314 L 180,320 L 176,326
            L 172,332 L 170,340 L 174,346 L 178,352
            L 184,356 L 190,358 L 196,354 L 200,348
            L 205,342 L 208,336 L 212,330 L 208,324
            L 204,318 L 208,312 L 212,306 L 216,300
            L 220,294 L 224,288 L 228,282 L 232,276
            L 236,270 L 240,264 L 244,258 L 248,252
            L 252,246 L 256,240 L 260,234 L 256,228
            L 252,222 L 256,216 L 252,210 L 248,204
            L 252,198 L 256,192 L 260,186 L 256,180
            L 252,174 L 256,168 L 252,162 L 248,156
            L 244,150 L 248,144 L 244,138 L 240,132
            L 236,126 L 240,120 L 236,114 L 232,108
            L 228,102 L 224,96 L 228,90 L 224,84
            L 220,78 L 216,72 L 212,66 L 208,60
            L 204,54 L 200,48 L 196,42 L 200,36 Z
          "/>
          <!-- Wales bump -->
          <path d="M 172,332 L 160,328 L 148,320 L 140,308 L 138,296 L 144,285 L 156,278 L 168,282 L 176,292 L 180,304 L 176,316 L 172,326 Z"/>
          <!-- Scotland upper -->
          <path d="M 200,28 L 194,22 L 188,16 L 182,12 L 176,18 L 170,24 L 164,30 L 160,38 L 164,46 L 170,52 L 176,58 L 182,52 L 188,46 L 194,40 Z"/>
          <path d="M 188,16 L 180,10 L 172,6 L 164,10 L 158,18 L 154,26 L 150,34 L 146,42 L 150,48 L 156,42 L 162,36 L 168,30 Z"/>
        </g>

        <!-- Animated route path -->
        <path id="route-path"
          d={festivals.map((f, i) => {
            const x = f.x * 4;
            const y = f.y * 5.2;
            return (i === 0 ? `M ${x},${y}` : `L ${x},${y}`);
          }).join(' ')}
          fill="none"
          stroke="#f0a500"
          stroke-width="1.5"
          stroke-dasharray="6,4"
          opacity="0.5"
          id="route-line"
        />

        <!-- Festival pins -->
        {festivals.map((f) => {
          const cx = f.x * 4;
          const cy = f.y * 5.2;
          const isCompleted = f.status === 'completed';
          const isCurrent = f.status === 'current';
          const glowColor = isCompleted ? '#2a7c6f' : isCurrent ? '#f0a500' : 'rgba(255,255,255,0.6)';

          return (
            <g
              class={`pin pin--${f.status}`}
              data-id={f.id}
              transform={`translate(${cx}, ${cy})`}
              role="button"
              tabindex="0"
              aria-label={f.name}
            >
              {isCurrent && (
                <circle class="pulse-ring" cx="0" cy="0" r="18" fill="none" stroke="#f0a500" stroke-width="2" opacity="0.6"/>
              )}
              <circle cx="0" cy="0" r="14" fill={isCompleted ? '#1e5c52' : isCurrent ? '#c68a00' : '#111'} stroke={glowColor} stroke-width="1.5"/>
              <image
                href="/castaway-logo.png"
                x="-10" y="-10"
                width="20" height="20"
                style="filter: invert(1); opacity: 0.9;"
              />
              <text x="0" y="24" text-anchor="middle" font-family="Arial,sans-serif" font-size="8" fill="rgba(255,255,255,0.7)" font-weight="bold">{f.num}</text>
            </g>
          );
        })}

      </svg>
    </div>

    <!-- DETAILS PANEL -->
    <div class="details-panel">

      <!-- Progress tracker -->
      <div class="tracker">
        <p class="eyebrow">Season progress</p>
        <div class="tracker-bar-row">
          <div class="tracker-bar-track">
            <div class="tracker-bar-fill" style={`width: ${(completedCount / festivals.length) * 100}%`}></div>
          </div>
          <span class="tracker-bar-label">{completedCount} of {festivals.length}</span>
        </div>

        <ul class="tracker-list">
          {festivals.map((f) => (
            <li
              class={`tracker-item tracker-item--${f.status}`}
              data-id={f.id}
              role="button"
              tabindex="0"
            >
              <span class="tracker-icon">
                {f.status === 'completed' && '✓'}
                {f.status === 'current' && '◉'}
                {f.status === 'upcoming' && '○'}
              </span>
              <span class="tracker-num">{f.num}</span>
              <span class="tracker-name">{f.name}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Festival detail card -->
      <div class="detail-card" id="detail-card">
        <div class="detail-card-inner">
          <span class="detail-status" id="detail-status">SELECT A FESTIVAL</span>
          <h3 class="display detail-name" id="detail-name">Click any pin</h3>
          <p class="detail-dates" id="detail-dates">—</p>
          <p class="detail-location" id="detail-location">—</p>
          <p class="detail-desc" id="detail-desc">Click any festival pin or name to see details.</p>
          <a href="#" class="detail-link btn btn--primary" id="detail-link" style="display:none">Festival Site →</a>
        </div>
      </div>

    </div>
  </div>

</div>

<style>
  .roadmap-wrap {
    width: 100%;
  }

  /* NEXT BANNER */
  .next-banner {
    background: var(--black);
    border: 1px solid rgba(42,124,111,0.3);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .next-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .next-eyebrow {
    display: block;
    margin-bottom: var(--space-xs);
  }

  .next-name {
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: var(--white);
    line-height: 1;
    margin-bottom: var(--space-xs);
  }

  .next-meta {
    color: rgba(255,255,255,0.5);
    font-size: var(--text-sm);
  }

  .countdown-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(42,124,111,0.15);
    border: 1px solid rgba(42,124,111,0.4);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    min-width: 120px;
  }

  .countdown-num {
    font-size: var(--text-5xl);
    color: var(--teal-light);
    line-height: 1;
  }

  .countdown-label {
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.5);
    margin-top: 4px;
  }

  /* MAP + PANEL GRID */
  .map-panel-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--space-lg);
    align-items: start;
  }

  /* MAP */
  .map-container {
    background: #0d1f1c;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(42,124,111,0.2);
    overflow: hidden;
    position: relative;
  }

  #festival-map {
    width: 100%;
    display: block;
  }

  /* PINS */
  .pin {
    cursor: pointer;
    transition: transform 0.2s;
  }

  .pin:hover,
  .pin:focus {
    transform: scale(1.3);
    outline: none;
  }

  .pin--completed circle:first-of-type {
    filter: drop-shadow(0 0 6px rgba(42,124,111,0.8));
  }

  .pin--current circle:first-of-type {
    filter: drop-shadow(0 0 8px rgba(240,165,0,0.9));
  }

  .pulse-ring {
    animation: pulse 1.8s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { r: 16; opacity: 0.6; }
    50% { r: 22; opacity: 0.1; }
  }

  /* ROUTE */
  #route-line {
    stroke-dashoffset: 2000;
    animation: drawRoute 3s ease-out forwards 0.5s;
  }

  @keyframes drawRoute {
    to { stroke-dashoffset: 0; }
  }

  /* DETAILS PANEL */
  .details-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* TRACKER */
  .tracker {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  .tracker-bar-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: var(--space-sm) 0 var(--space-md);
  }

  .tracker-bar-track {
    flex: 1;
    height: 8px;
    background: rgba(0,0,0,0.08);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .tracker-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--teal), var(--teal-light));
    border-radius: var(--radius-pill);
    transition: width 0.8s ease;
  }

  .tracker-bar-label {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--teal-dark);
    white-space: nowrap;
  }

  .tracker-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tracker-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background 0.15s;
    font-size: var(--text-sm);
  }

  .tracker-item:hover {
    background: rgba(42,124,111,0.08);
  }

  .tracker-item.active {
    background: rgba(42,124,111,0.12);
  }

  .tracker-icon {
    font-size: 14px;
    width: 18px;
    text-align: center;
    flex-shrink: 0;
  }

  .tracker-item--completed .tracker-icon { color: var(--teal); }
  .tracker-item--current .tracker-icon { color: #f0a500; }
  .tracker-item--upcoming .tracker-icon { color: rgba(0,0,0,0.3); }

  .tracker-num {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--warm-grey);
    width: 16px;
    flex-shrink: 0;
  }

  .tracker-name {
    font-weight: 600;
    color: var(--black);
    line-height: 1.3;
  }

  .tracker-item--upcoming .tracker-name {
    color: var(--warm-grey);
  }

  /* DETAIL CARD */
  .detail-card {
    background: var(--black);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(42,124,111,0.3);
    overflow: hidden;
    min-height: 200px;
  }

  .detail-card-inner {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .detail-status {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--teal-light);
  }

  .detail-name {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    color: var(--white);
    line-height: 1;
  }

  .detail-dates,
  .detail-location {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.5);
    font-weight: 600;
  }

  .detail-desc {
    font-size: var(--text-sm);
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    margin-top: 4px;
  }

  .detail-link {
    margin-top: var(--space-sm);
    align-self: flex-start;
    font-size: var(--text-xs);
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .map-panel-grid {
      grid-template-columns: 1fr;
    }

    .details-panel {
      flex-direction: column;
    }
  }
</style>

<script>
  const FESTIVALS = [
    { id: 'cheltenham-jazz', num: 1, name: 'Cheltenham Jazz Festival', dates: '28 Apr – 5 May', location: 'Cheltenham, Gloucestershire', status: 'completed', desc: 'Our home patch. Scott grew up in Chipping Campden — Cheltenham Jazz is where the season begins.', url: 'https://www.cheltenhamfestivals.com/jazz' },
    { id: 'big-retreat', num: 2, name: 'The Big Retreat Festival', dates: '21 – 26 May', location: 'Lawrenny, Pembrokeshire', status: 'completed', desc: 'Wellness, music and good vibes on the Pembrokeshire coast. A different crowd, a brilliant atmosphere.', url: 'https://www.thebigretreatfestival.com/' },
    { id: '2000trees', num: 3, name: '2000trees Festival', dates: '7 – 12 Jul', location: 'Upcote Farm, Cheltenham', status: 'current', desc: "Consistently one of the best-run festivals in the UK. Indie, alternative, and we're proud to be part of it.", url: 'https://2000trees.co.uk/' },
    { id: 'emf', num: 4, name: 'Electromagnetic Field', dates: '16 – 19 Jul', location: 'Eastnor Castle Deer Park, Herefordshire', status: 'upcoming', desc: 'Tech, art and making. A unique crowd who appreciate proper food as much as a good hack.', url: 'https://www.emfcamp.org/' },
    { id: 'camp-bestival', num: 5, name: 'Camp Bestival', dates: '29 Jul – 3 Aug', location: 'Lulworth Castle, Dorset', status: 'upcoming', desc: 'Family festival at a stunning Dorset castle. Big crowds, brilliant energy, and gyros going fast.', url: 'https://dorset.campbestival.net/' },
    { id: 'lakefest', num: 6, name: 'Lakefest', dates: '4 – 10 Aug', location: 'Eastnor Castle Deer Park, Herefordshire', status: 'upcoming', desc: "Lakeside vibes, brilliant crowd, and a pitch right in the heart of the action. One of our favourites.", url: 'https://www.lakefest.co.uk/' },
    { id: 'beautiful-days', num: 7, name: 'Beautiful Days', dates: '20 – 24 Aug', location: 'Escot Park, Devon', status: 'upcoming', desc: 'An institution. Beautiful setting, loyal crowd, and Cornwall just down the road.', url: 'https://www.beautifuldays.org/' },
    { id: 'forwards', num: 8, name: 'Forwards Festival', dates: '26 – 31 Aug', location: 'Bristol', status: 'upcoming', desc: "Bristol's biggest music festival. Urban, diverse and seriously good fun.", url: 'https://www.forwardsbristol.co.uk/' },
    { id: 'we-have-ways', num: 9, name: 'We Have Ways Festival', dates: '10 – 14 Sep', location: 'Blackpit Farm, Buckinghamshire', status: 'upcoming', desc: 'History, music and community in the Buckinghamshire countryside. Season finale vibes.', url: 'https://wehavewaysfest.co.uk/' },
  ];

  function selectFestival(id) {
    const f = FESTIVALS.find(fest => fest.id === id);
    if (!f) return;

    document.querySelectorAll('.pin').forEach(p => p.classList.remove('pin--active'));
    document.querySelectorAll('.tracker-item').forEach(t => t.classList.remove('active'));

    const pin = document.querySelector(`.pin[data-id="${id}"]`);
    pin?.classList.add('pin--active');

    const trackerItem = document.querySelector(`.tracker-item[data-id="${id}"]`);
    trackerItem?.classList.add('active');

    const statusMap = { completed: 'COMPLETED ✓', current: 'CURRENT FESTIVAL ◉', upcoming: 'UPCOMING' };
    document.getElementById('detail-status').textContent = statusMap[f.status];
    document.getElementById('detail-name').textContent = f.name;
    document.getElementById('detail-dates').textContent = '📅 ' + f.dates;
    document.getElementById('detail-location').textContent = '📍 ' + f.location;
    document.getElementById('detail-desc').textContent = f.desc;

    const link = document.getElementById('detail-link');
    link.href = f.url;
    link.style.display = 'inline-flex';
  }

  document.querySelectorAll('.pin').forEach(pin => {
    pin.addEventListener('click', () => selectFestival(pin.dataset.id));
    pin.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') selectFestival(pin.dataset.id); });
  });

  document.querySelectorAll('.tracker-item').forEach(item => {
    item.addEventListener('click', () => selectFestival(item.dataset.id));
    item.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') selectFestival(item.dataset.id); });
  });

  // Countdown
  const nextDates = {
    'cheltenham-jazz': new Date('2026-04-28'),
    'big-retreat': new Date('2026-05-21'),
    '2000trees': new Date('2026-07-07'),
    'emf': new Date('2026-07-16'),
    'camp-bestival': new Date('2026-07-29'),
    'lakefest': new Date('2026-08-04'),
    'beautiful-days': new Date('2026-08-20'),
    'forwards': new Date('2026-08-26'),
    'we-have-ways': new Date('2026-09-10'),
  };

  const next = FESTIVALS.find(f => f.status === 'current') || FESTIVALS.find(f => f.status === 'upcoming');
  if (next) {
    const target = nextDates[next.id];
    const now = new Date();
    const days = Math.max(0, Math.ceil((target - now) / (1000 * 60 * 60 * 24)));
    document.getElementById('countdown-days').textContent = days;
  }

  // Auto-select current festival on load
  const current = FESTIVALS.find(f => f.status === 'current');
  if (current) selectFestival(current.id);
</script>
