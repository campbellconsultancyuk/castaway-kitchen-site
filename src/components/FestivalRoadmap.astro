---
const festivals = [
  {
    id: 'cheltenham-jazz',
    num: 1,
    name: 'Cheltenham Jazz Festival',
    dates: '28 Apr – 5 May',
    location: 'Cheltenham, Gloucestershire',
    status: 'completed',
    desc: "Our home patch. Scott grew up in Chipping Campden — Cheltenham Jazz is where the season begins.",
    url: 'https://www.cheltenhamfestivals.com/jazz',
    px: 664, py: 803,
    gyros: 280, miles: 0,
  },
  {
    id: 'big-retreat',
    num: 2,
    name: 'The Big Retreat Festival',
    dates: '21 – 26 May',
    location: 'Lawrenny, Pembrokeshire',
    status: 'completed',
    desc: 'Wellness, music and good vibes on the Pembrokeshire coast. A different crowd, a brilliant atmosphere.',
    url: 'https://www.thebigretreatfestival.com/',
    px: 526, py: 818,
    gyros: 320, miles: 180,
  },
  {
    id: '2000trees',
    num: 3,
    name: '2000trees Festival',
    dates: '7 – 12 Jul',
    location: 'Upcote Farm, Cheltenham',
    status: 'current',
    desc: "Consistently one of the best-run festivals in the UK. Indie, alternative, and we're proud to be part of it.",
    url: 'https://2000trees.co.uk/',
    px: 660, py: 800,
    gyros: 450, miles: 8,
  },
  {
    id: 'emf',
    num: 4,
    name: 'Electromagnetic Field',
    dates: '16 – 19 Jul',
    location: 'Eastnor Castle, Herefordshire',
    status: 'upcoming',
    desc: 'Tech, art and making. A unique crowd who appreciate proper food as much as a good hack.',
    url: 'https://www.emfcamp.org/',
    px: 645, py: 788,
    gyros: 310, miles: 12,
  },
  {
    id: 'camp-bestival',
    num: 5,
    name: 'Camp Bestival',
    dates: '29 Jul – 3 Aug',
    location: 'Lulworth Castle, Dorset',
    status: 'upcoming',
    desc: 'Family festival at a stunning Dorset castle. Big crowds, brilliant energy, and gyros going fast.',
    url: 'https://dorset.campbestival.net/',
    px: 648, py: 915,
    gyros: 520, miles: 95,
  },
  {
    id: 'lakefest',
    num: 6,
    name: 'Lakefest',
    dates: '4 – 10 Aug',
    location: 'Eastnor Castle, Herefordshire',
    status: 'upcoming',
    desc: "Lakeside vibes, brilliant crowd, and a pitch right in the heart of the action. One of our favourites.",
    url: 'https://www.lakefest.co.uk/',
    px: 650, py: 793,
    gyros: 480, miles: 12,
  },
  {
    id: 'beautiful-days',
    num: 7,
    name: 'Beautiful Days',
    dates: '20 – 24 Aug',
    location: 'Escot Park, Devon',
    status: 'upcoming',
    desc: 'An institution. Beautiful setting, loyal crowd, and Cornwall just down the road.',
    url: 'https://www.beautifuldays.org/',
    px: 588, py: 901,
    gyros: 390, miles: 145,
  },
  {
    id: 'forwards',
    num: 8,
    name: 'Forwards Festival',
    dates: '26 – 31 Aug',
    location: 'Bristol',
    status: 'upcoming',
    desc: "Bristol's biggest music festival. Urban, diverse and seriously good fun.",
    url: 'https://www.forwardsbristol.co.uk/',
    px: 630, py: 842,
    gyros: 420, miles: 55,
  },
  {
    id: 'we-have-ways',
    num: 9,
    name: 'We Have Ways Festival',
    dates: '10 – 14 Sep',
    location: 'Blackpit Farm, Buckinghamshire',
    status: 'upcoming',
    desc: 'History, music and community in the Buckinghamshire countryside. Season finale.',
    url: 'https://wehavewaysfest.co.uk/',
    px: 705, py: 797,
    gyros: 360, miles: 82,
  },
];

const nextFestival = festivals.find(f => f.status === 'current') || festivals.find(f => f.status === 'upcoming');
const completedCount = festivals.filter(f => f.status === 'completed').length;
const routePoints = festivals.map(f => `${f.px},${f.py}`).join(' ');
---

<div class="roadmap-wrap">

  <!-- NEXT FESTIVAL BANNER -->
  <div class="next-banner">
    <div class="next-banner-inner">
      <div class="next-left">
        <span class="eyebrow next-eyebrow">Next up</span>
        <h2 class="display next-name">{nextFestival?.name}</h2>
        <p class="next-meta">📅 {nextFestival?.dates} &nbsp;·&nbsp; 📍 {nextFestival?.location}</p>
      </div>
      <div class="next-right">
        <div class="countdown-wrap">
          <span class="display countdown-num" id="countdown-days">--</span>
          <span class="countdown-label">Days to go</span>
        </div>
      </div>
    </div>
  </div>

  <!-- MAP + PANEL -->
  <div class="map-panel-grid">

    <!-- MAP using real UK SVG -->
    <div class="map-container">
      <svg id="festival-map" viewBox="380 650 400 350" xmlns="http://www.w3.org/2000/svg">

        <!-- Real UK map imported as image -->
        <image
          href="/Maps/uk.svg"
          x="0" y="0"
          width="1000" height="1000"
          style="filter: saturate(0) brightness(0.3) sepia(1) hue-rotate(120deg) brightness(0.6);"
        />

        <!-- Animated route -->
        <polyline
          points={routePoints}
          fill="none"
          stroke="#f0a500"
          stroke-width="2"
          stroke-dasharray="6,4"
          opacity="0.7"
          id="route-line"
        />

        <!-- Festival pins -->
        {festivals.map((f) => {
          const isCompleted = f.status === 'completed';
          const isCurrent = f.status === 'current';
          const ringColor = isCompleted ? '#2a7c6f' : isCurrent ? '#f0a500' : 'rgba(255,255,255,0.6)';
          const fillColor = isCompleted ? '#1a5c4e' : isCurrent ? '#8a5c00' : '#1a1a1a';

          return (
            <g
              class={`pin pin--${f.status}`}
              data-id={f.id}
              transform={`translate(${f.px}, ${f.py})`}
              role="button"
              tabindex="0"
              aria-label={f.name}
            >
              {isCurrent && (
                <circle class="pulse-ring" cx="0" cy="0" r="14" fill="none" stroke="#f0a500" stroke-width="1.5" opacity="0.6"/>
              )}
              <circle cx="0" cy="0" r="9" fill={fillColor} stroke={ringColor} stroke-width="1.8"/>
              <image
                href="/castaway-logo.png"
                x="-6" y="-6"
                width="12" height="12"
                style="filter: invert(1); opacity: 0.95;"
              />
            </g>
          );
        })}

      </svg>

      <!-- Legend -->
      <div class="map-legend">
        <div class="legend-item"><span class="legend-dot legend-dot--completed"></span>Completed</div>
        <div class="legend-item"><span class="legend-dot legend-dot--current"></span>Current</div>
        <div class="legend-item"><span class="legend-dot legend-dot--upcoming"></span>Upcoming</div>
      </div>
    </div>

    <!-- DETAILS PANEL -->
    <div class="details-panel">

      <!-- Progress tracker -->
      <div class="tracker">
        <p class="eyebrow">Season progress</p>
        <div class="tracker-bar-row">
          <div class="tracker-bar-track">
            <div class="tracker-bar-fill" style={`width: ${(completedCount / festivals.length) * 100}%`}></div>
          </div>
          <span class="tracker-bar-label">{completedCount} of {festivals.length}</span>
        </div>
        <ul class="tracker-list">
          {festivals.map((f) => (
            <li class={`tracker-item tracker-item--${f.status}`} data-id={f.id} role="button" tabindex="0">
              <span class="tracker-icon">
                {f.status === 'completed' && '✓'}
                {f.status === 'current' && '◉'}
                {f.status === 'upcoming' && '○'}
              </span>
              <span class="tracker-num">{f.num}</span>
              <span class="tracker-name">{f.name}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Detail card -->
      <div class="detail-card">
        <div class="detail-card-inner">
          <span class="detail-status" id="detail-status">SELECT A FESTIVAL</span>
          <h3 class="display detail-name" id="detail-name">Click any pin</h3>
          <p class="detail-dates" id="detail-dates">—</p>
          <p class="detail-location" id="detail-location">—</p>
          <p class="detail-desc" id="detail-desc">Click any festival pin or name to see details.</p>
          <a href="#" class="btn btn--primary detail-link" id="detail-link" style="display:none; margin-top: var(--space-sm); font-size: var(--text-xs);">Festival Site →</a>
        </div>
      </div>

    </div>
  </div>

</div>

<style>
  .roadmap-wrap { width: 100%; }

  .next-banner {
    background: var(--black);
    border: 1px solid rgba(42,124,111,0.3);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .next-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .next-eyebrow { display: block; margin-bottom: var(--space-xs); }

  .next-name {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    color: var(--white);
    line-height: 1;
    margin-bottom: var(--space-xs);
  }

  .next-meta { color: rgba(255,255,255,0.5); font-size: var(--text-sm); }

  .countdown-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(42,124,111,0.15);
    border: 1px solid rgba(42,124,111,0.4);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    min-width: 110px;
  }

  .countdown-num { font-size: var(--text-5xl); color: var(--teal-light); line-height: 1; }
  .countdown-label {
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.5);
    margin-top: 4px;
    text-align: center;
  }

  .map-panel-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-lg);
    align-items: start;
  }

  .map-container {
    background: #0a1a17;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(42,124,111,0.25);
    overflow: hidden;
    position: relative;
  }

  #festival-map { width: 100%; display: block; }

  .map-legend {
    position: absolute;
    bottom: var(--space-sm);
    left: var(--space-sm);
    display: flex;
    gap: var(--space-md);
    background: rgba(0,0,0,0.7);
    border-radius: var(--radius-md);
    padding: 6px 12px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 700;
    color: rgba(255,255,255,0.6);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid;
    flex-shrink: 0;
  }

  .legend-dot--completed { background: #1a5c4e; border-color: #2a7c6f; }
  .legend-dot--current { background: #8a5c00; border-color: #f0a500; }
  .legend-dot--upcoming { background: #1a1a1a; border-color: rgba(255,255,255,0.6); }

  .pin { cursor: pointer; transition: transform 0.2s ease; transform-origin: center; }
  .pin:hover, .pin:focus { transform: scale(1.4); outline: none; }

  .pulse-ring { animation: pulse 2s ease-in-out infinite; }

  @keyframes pulse {
    0%, 100% { opacity: 0.6; r: 12; }
    50% { opacity: 0.1; r: 20; }
  }

  #route-line {
    stroke-dashoffset: 3000;
    animation: drawRoute 2.5s ease-out 0.5s forwards;
  }

  @keyframes drawRoute { to { stroke-dashoffset: 0; } }

  .details-panel { display: flex; flex-direction: column; gap: var(--space-md); }

  .tracker {
    background: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  .tracker-bar-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin: var(--space-sm) 0 var(--space-md);
  }

  .tracker-bar-track {
    flex: 1;
    height: 8px;
    background: rgba(0,0,0,0.08);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .tracker-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--teal), var(--teal-light));
    border-radius: var(--radius-pill);
  }

  .tracker-bar-label {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--teal-dark);
    white-space: nowrap;
  }

  .tracker-list { display: flex; flex-direction: column; gap: 1px; }

  .tracker-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background 0.15s;
  }

  .tracker-item:hover { background: rgba(42,124,111,0.08); }
  .tracker-item.active { background: rgba(42,124,111,0.12); }

  .tracker-icon { font-size: 13px; width: 16px; text-align: center; flex-shrink: 0; }
  .tracker-item--completed .tracker-icon { color: var(--teal); }
  .tracker-item--current .tracker-icon { color: #f0a500; }
  .tracker-item--upcoming .tracker-icon { color: rgba(0,0,0,0.25); }

  .tracker-num { font-size: var(--text-xs); font-weight: 800; color: var(--warm-grey); width: 14px; flex-shrink: 0; }
  .tracker-name { font-weight: 600; color: var(--black); font-size: var(--text-sm); line-height: 1.3; }
  .tracker-item--upcoming .tracker-name { color: var(--warm-grey); }

  .detail-card {
    background: var(--black);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(42,124,111,0.3);
    min-height: 180px;
  }

  .detail-card-inner {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .detail-status { font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.12em; color: var(--teal-light); }
  .detail-name { font-size: clamp(1.4rem, 2.5vw, 2rem); color: var(--white); line-height: 1; }
  .detail-dates, .detail-location { font-size: var(--text-sm); color: rgba(255,255,255,0.5); font-weight: 600; }
  .detail-desc { font-size: var(--text-sm); color: rgba(255,255,255,0.6); line-height: 1.6; }

  @media (max-width: 900px) {
    .map-panel-grid { grid-template-columns: 1fr; }
    .map-legend { flex-wrap: wrap; }
  }
</style>

<script>
  const FESTIVALS = [
    { id: 'cheltenham-jazz', num: 1, name: 'Cheltenham Jazz Festival', dates: '28 Apr – 5 May', location: 'Cheltenham, Gloucestershire', status: 'completed', desc: 'Our home patch. Scott grew up in Chipping Campden — Cheltenham Jazz is where the season begins.', url: 'https://www.cheltenhamfestivals.com/jazz' },
    { id: 'big-retreat', num: 2, name: 'The Big Retreat Festival', dates: '21 – 26 May', location: 'Lawrenny, Pembrokeshire', status: 'completed', desc: 'Wellness, music and good vibes on the Pembrokeshire coast. A different crowd, a brilliant atmosphere.', url: 'https://www.thebigretreatfestival.com/' },
    { id: '2000trees', num: 3, name: '2000trees Festival', dates: '7 – 12 Jul', location: 'Upcote Farm, Cheltenham', status: 'current', desc: "Consistently one of the best-run festivals in the UK. Indie, alternative, and we're proud to be part of it.", url: 'https://2000trees.co.uk/' },
    { id: 'emf', num: 4, name: 'Electromagnetic Field', dates: '16 – 19 Jul', location: 'Eastnor Castle, Herefordshire', status: 'upcoming', desc: 'Tech, art and making. A unique crowd who appreciate proper food as much as a good hack.', url: 'https://www.emfcamp.org/' },
    { id: 'camp-bestival', num: 5, name: 'Camp Bestival', dates: '29 Jul – 3 Aug', location: 'Lulworth Castle, Dorset', status: 'upcoming', desc: 'Family festival at a stunning Dorset castle. Big crowds, brilliant energy, and gyros going fast.', url: 'https://dorset.campbestival.net/' },
    { id: 'lakefest', num: 6, name: 'Lakefest', dates: '4 – 10 Aug', location: 'Eastnor Castle, Herefordshire', status: 'upcoming', desc: "Lakeside vibes, brilliant crowd, and a pitch right in the heart of the action. One of our favourites.", url: 'https://www.lakefest.co.uk/' },
    { id: 'beautiful-days', num: 7, name: 'Beautiful Days', dates: '20 – 24 Aug', location: 'Escot Park, Devon', status: 'upcoming', desc: 'An institution. Beautiful setting, loyal crowd, and Cornwall just down the road.', url: 'https://www.beautifuldays.org/' },
    { id: 'forwards', num: 8, name: 'Forwards Festival', dates: '26 – 31 Aug', location: 'Bristol', status: 'upcoming', desc: "Bristol's biggest music festival. Urban, diverse and seriously good fun.", url: 'https://www.forwardsbristol.co.uk/' },
    { id: 'we-have-ways', num: 9, name: 'We Have Ways Festival', dates: '10 – 14 Sep', location: 'Blackpit Farm, Buckinghamshire', status: 'upcoming', desc: 'History, music and community in the Buckinghamshire countryside. Season finale.', url: 'https://wehavewaysfest.co.uk/' },
  ];

  const STATUS_LABELS = { completed: 'COMPLETED ✓', current: 'CURRENT FESTIVAL ◉', upcoming: 'UPCOMING' };

  function selectFestival(id) {
    const f = FESTIVALS.find(fest => fest.id === id);
    if (!f) return;
    document.querySelectorAll('.pin').forEach(p => p.classList.remove('pin--active'));
    document.querySelectorAll('.tracker-item').forEach(t => t.classList.remove('active'));
    document.querySelector(`.pin[data-id="${id}"]`)?.classList.add('pin--active');
    document.querySelector(`.tracker-item[data-id="${id}"]`)?.classList.add('active');
    document.getElementById('detail-status').textContent = STATUS_LABELS[f.status];
    document.getElementById('detail-name').textContent = f.name;
    document.getElementById('detail-dates').textContent = '📅 ' + f.dates;
    document.getElementById('detail-location').textContent = '📍 ' + f.location;
    document.getElementById('detail-desc').textContent = f.desc;
    const link = document.getElementById('detail-link');
    link.href = f.url;
    link.style.display = 'inline-flex';
  }

  document.querySelectorAll('.pin').forEach(pin => {
    pin.addEventListener('click', () => selectFestival(pin.dataset.id));
    pin.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') selectFestival(pin.dataset.id); });
  });

  document.querySelectorAll('.tracker-item').forEach(item => {
    item.addEventListener('click', () => selectFestival(item.dataset.id));
    item.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') selectFestival(item.dataset.id); });
  });

  const nextDates = {
    'cheltenham-jazz': new Date('2026-04-28'), 'big-retreat': new Date('2026-05-21'),
    '2000trees': new Date('2026-07-07'), 'emf': new Date('2026-07-16'),
    'camp-bestival': new Date('2026-07-29'), 'lakefest': new Date('2026-08-04'),
    'beautiful-days': new Date('2026-08-20'), 'forwards': new Date('2026-08-26'),
    'we-have-ways': new Date('2026-09-10'),
  };

  const next = FESTIVALS.find(f => f.status === 'current') || FESTIVALS.find(f => f.status === 'upcoming');
  if (next) {
    const days = Math.max(0, Math.ceil((nextDates[next.id] - new Date()) / 86400000));
    document.getElementById('countdown-days').textContent = days;
  }

  const current = FESTIVALS.find(f => f.status === 'current');
  if (current) selectFestival(current.id);
</script>