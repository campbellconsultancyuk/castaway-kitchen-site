---
const festivals = [
  { id: 'cheltenham-jazz', num: 1, name: 'Cheltenham Jazz Festival', dates: '28 Apr – 5 May', location: 'Cheltenham, Gloucestershire', status: 'completed', desc: "Our home patch. Scott grew up in Chipping Campden — Cheltenham Jazz is where the season begins.", url: 'https://www.cheltenhamfestivals.com/jazz', left: 66.9, top: 71.8, gyros: 280, miles: 0 },
  { id: 'big-retreat', num: 2, name: 'The Big Retreat Festival', dates: '21 – 26 May', location: 'Lawrenny, Pembrokeshire', status: 'completed', desc: 'Wellness, music and good vibes on the Pembrokeshire coast. A different crowd, a brilliant atmosphere.', url: 'https://www.thebigretreatfestival.com/', left: 55.0, top: 73.2, gyros: 320, miles: 180 },
  { id: '2000trees', num: 3, name: '2000trees Festival', dates: '7 – 12 Jul', location: 'Upcote Farm, Cheltenham', status: 'current', desc: "Consistently one of the best-run festivals in the UK. Indie, alternative, and we're proud to be part of it.", url: 'https://2000trees.co.uk/', left: 67.0, top: 71.6, gyros: 450, miles: 8 },
  { id: 'emf', num: 4, name: 'Electromagnetic Field', dates: '16 – 19 Jul', location: 'Eastnor Castle, Herefordshire', status: 'upcoming', desc: 'Tech, art and making. A unique crowd who appreciate proper food as much as a good hack.', url: 'https://www.emfcamp.org/', left: 66.0, top: 70.8, gyros: 310, miles: 12 },
  { id: 'camp-bestival', num: 5, name: 'Camp Bestival', dates: '29 Jul – 3 Aug', location: 'Lulworth Castle, Dorset', status: 'upcoming', desc: 'Family festival at a stunning Dorset castle. Big crowds, brilliant energy, and gyros going fast.', url: 'https://dorset.campbestival.net/', left: 66.4, top: 79.0, gyros: 520, miles: 95 },
  { id: 'lakefest', num: 6, name: 'Lakefest', dates: '4 – 10 Aug', location: 'Eastnor Castle, Herefordshire', status: 'upcoming', desc: "Lakeside vibes, brilliant crowd, and a pitch right in the heart of the action. One of our favourites.", url: 'https://www.lakefest.co.uk/', left: 64.5, top: 69.5, gyros: 480, miles: 12 },
  { id: 'beautiful-days', num: 7, name: 'Beautiful Days', dates: '20 – 24 Aug', location: 'Escot Park, Devon', status: 'upcoming', desc: 'An institution. Beautiful setting, loyal crowd, and Cornwall just down the road.', url: 'https://www.beautifuldays.org/', left: 60.0, top: 82.5, gyros: 390, miles: 145 },
  { id: 'forwards', num: 8, name: 'Forwards Festival', dates: '26 – 31 Aug', location: 'Bristol', status: 'upcoming', desc: "Bristol's biggest music festival. Urban, diverse and seriously good fun.", url: 'https://www.forwardsbristol.co.uk/', left: 65.5, top: 75.4, gyros: 420, miles: 55 },
  { id: 'we-have-ways', num: 9, name: 'We Have Ways Festival', dates: '10 – 14 Sep', location: 'Blackpit Farm, Buckinghamshire', status: 'upcoming', desc: 'History, music and community in the Buckinghamshire countryside. Season finale.', url: 'https://wehavewaysfest.co.uk/', left: 68.0, top: 70.0, gyros: 360, miles: 82 },
];

const nextFestival = festivals.find(f => f.status === 'current') || festivals.find(f => f.status === 'upcoming');
const completedCount = festivals.filter(f => f.status === 'completed').length;
---

<div class="roadmap-wrap">

  <!-- NEXT FESTIVAL BANNER -->
  <div class="next-banner">
    <div class="next-banner-inner">
      <div class="next-left">
        <span class="eyebrow next-eyebrow">Next up</span>
        <h2 class="display next-name">{nextFestival?.name}</h2>
        <p class="next-meta">📅 {nextFestival?.dates} &nbsp;·&nbsp; 📍 {nextFestival?.location}</p>
      </div>
      <div class="countdown-wrap">
        <span class="display countdown-num" id="countdown-days">--</span>
        <span class="countdown-label">Days to go</span>
      </div>
    </div>
  </div>

  <!-- MAP + PANEL -->
  <div class="map-panel-grid">

    <!-- MAP -->
<div class="map-container">
  <img src="/Maps/uk-brand.svg" alt="" class="map-bg" aria-hidden="true" />
      <!-- SVG route lines drawn on top of map -->
      <svg class="route-svg" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <polyline
          id="route-line"
          points={festivals.map(f => `${f.left},${f.top}`).join(' ')}
          fill="none"
          stroke="#f0a500"
          stroke-width="0.6"
          stroke-dasharray="2,1.5"
          opacity="0.7"
          vector-effect="non-scaling-stroke"
        />
      </svg>

      <!-- Festival pins -->
      {festivals.map((f) => (
        <button
          class={`map-pin map-pin--${f.status}`}
          data-id={f.id}
          style={`left: ${f.left}%; top: ${f.top}%;`}
          aria-label={f.name}
          type="button"
        >
          <img src="/castaway-logo.png" alt="" width="16" height="16" />
          <span class="pin-num">{f.num}</span>
        </button>
      ))}

      <!-- Legend -->
      <div class="map-legend">
        <div class="legend-item"><span class="legend-dot legend-dot--completed"></span>Done</div>
        <div class="legend-item"><span class="legend-dot legend-dot--current"></span>Now</div>
        <div class="legend-item"><span class="legend-dot legend-dot--upcoming"></span>Next</div>
      </div>
    </div>

    <!-- PANEL -->
    <div class="details-panel">
      <div class="tracker">
        <p class="eyebrow">Season progress</p>
        <div class="tracker-bar-row">
          <div class="tracker-bar-track">
            <div class="tracker-bar-fill" style={`width: ${(completedCount / festivals.length) * 100}%`}></div>
          </div>
          <span class="tracker-bar-label">{completedCount} of {festivals.length}</span>
        </div>
        <ul class="tracker-list">
          {festivals.map((f) => (
            <li class={`tracker-item tracker-item--${f.status}`} data-id={f.id} role="button" tabindex="0">
              <span class="tracker-icon">
                {f.status === 'completed' && '✓'}
                {f.status === 'current' && '◉'}
                {f.status === 'upcoming' && '○'}
              </span>
              <span class="tracker-num">{f.num}</span>
              <span class="tracker-name">{f.name}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="detail-card">
        <div class="detail-card-inner">
          <span class="detail-status" id="detail-status">SELECT A FESTIVAL</span>
          <h3 class="display detail-name" id="detail-name">Click any pin</h3>
          <p class="detail-dates" id="detail-dates">—</p>
          <p class="detail-location" id="detail-location">—</p>
          <p class="detail-desc" id="detail-desc">Click any festival pin or name to see details.</p>
          <a href="#" class="btn btn--primary detail-link" id="detail-link" style="display:none; margin-top: var(--space-sm); font-size: var(--text-xs);">Festival Site →</a>
        </div>
      </div>
    </div>
  </div>

</div>

<style>
  .roadmap-wrap { width: 100%; }

  /* BANNER */
  .next-banner {
    background: var(--black);
    border: 1px solid rgba(42,124,111,0.3);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .next-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .next-eyebrow { display: block; margin-bottom: var(--space-xs); }
  .next-name { font-size: clamp(1.8rem, 3.5vw, 2.8rem); color: var(--white); line-height: 1; margin-bottom: var(--space-xs); }
  .next-meta { color: rgba(255,255,255,0.5); font-size: var(--text-sm); }

  .countdown-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(42,124,111,0.15);
    border: 1px solid rgba(42,124,111,0.4);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    min-width: 110px;
    flex-shrink: 0;
  }

  .countdown-num { font-size: var(--text-5xl); color: var(--teal-light); line-height: 1; }
  .countdown-label { font-size: var(--text-xs); font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.5); margin-top: 4px; text-align: center; }

  /* GRID */
  .map-panel-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-lg);
    align-items: start;
  }

  /* MAP */
 .map-container {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background-color: #050e0c;
  aspect-ratio: 3/4;
}

.map-bg {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center center;
  pointer-events: none;
}

  .route-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  #route-line {
    stroke-dashoffset: 500;
    animation: drawRoute 2.5s ease-out 0.5s forwards;
  }

  @keyframes drawRoute { to { stroke-dashoffset: 0; } }

  /* PINS */
  .map-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.5);
    background: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    padding: 0;
    flex-direction: column;
    gap: 0;
  }

  .map-pin img { filter: invert(1); width: 14px; height: 14px; display: block; pointer-events: none; }
  .pin-num { display: none; }

  .map-pin:hover, .map-pin:focus, .map-pin.active {
    transform: translate(-50%, -50%) scale(1.3);
    outline: none;
    z-index: 10;
  }

  .map-pin--completed {
    background: #1a5c4e;
    border-color: #2a7c6f;
    box-shadow: 0 0 8px rgba(42,124,111,0.5);
  }

  .map-pin--current {
    background: #7a4800;
    border-color: #f0a500;
    box-shadow: 0 0 12px rgba(240,165,0,0.6);
    animation: pinPulse 2s ease-in-out infinite;
  }

  .map-pin--upcoming {
    background: #1a1a1a;
    border-color: rgba(255,255,255,0.4);
  }

  @keyframes pinPulse {
    0%, 100% { box-shadow: 0 0 8px rgba(240,165,0,0.4); }
    50% { box-shadow: 0 0 20px rgba(240,165,0,0.8); }
  }

  /* LEGEND */
  .map-legend {
    position: absolute;
    bottom: var(--space-sm);
    left: var(--space-sm);
    display: flex;
    gap: var(--space-sm);
    background: rgba(0,0,0,0.75);
    border-radius: var(--radius-md);
    padding: 6px 10px;
  }

  .legend-item { display: flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.05em; }

  .legend-dot { width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid; flex-shrink: 0; }
  .legend-dot--completed { background: #1a5c4e; border-color: #2a7c6f; }
  .legend-dot--current { background: #7a4800; border-color: #f0a500; }
  .legend-dot--upcoming { background: #1a1a1a; border-color: rgba(255,255,255,0.4); }

  /* PANEL */
  .details-panel { display: flex; flex-direction: column; gap: var(--space-md); }

  .tracker { background: var(--white); border-radius: var(--radius-lg); padding: var(--space-md); }

  .tracker-bar-row { display: flex; align-items: center; gap: var(--space-sm); margin: var(--space-sm) 0 var(--space-md); }

  .tracker-bar-track { flex: 1; height: 8px; background: rgba(0,0,0,0.08); border-radius: var(--radius-pill); overflow: hidden; }

  .tracker-bar-fill { height: 100%; background: linear-gradient(90deg, var(--teal), var(--teal-light)); border-radius: var(--radius-pill); }

  .tracker-bar-label { font-size: var(--text-xs); font-weight: 800; color: var(--teal-dark); white-space: nowrap; }

  .tracker-list { display: flex; flex-direction: column; gap: 1px; }

  .tracker-item { display: flex; align-items: center; gap: 8px; padding: 5px 8px; border-radius: var(--radius-sm); cursor: pointer; transition: background 0.15s; }
  .tracker-item:hover { background: rgba(42,124,111,0.08); }
  .tracker-item.active { background: rgba(42,124,111,0.12); }

  .tracker-icon { font-size: 13px; width: 16px; text-align: center; flex-shrink: 0; }
  .tracker-item--completed .tracker-icon { color: var(--teal); }
  .tracker-item--current .tracker-icon { color: #f0a500; }
  .tracker-item--upcoming .tracker-icon { color: rgba(0,0,0,0.25); }

  .tracker-num { font-size: var(--text-xs); font-weight: 800; color: var(--warm-grey); width: 14px; flex-shrink: 0; }
  .tracker-name { font-weight: 600; color: var(--black); font-size: var(--text-sm); line-height: 1.3; }
  .tracker-item--upcoming .tracker-name { color: var(--warm-grey); }

  .detail-card { background: var(--black); border-radius: var(--radius-lg); border: 1px solid rgba(42,124,111,0.3); min-height: 160px; }
  .detail-card-inner { padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); }
  .detail-status { font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.12em; color: var(--teal-light); }
  .detail-name { font-size: clamp(1.2rem, 2vw, 1.8rem); color: var(--white); line-height: 1; }
  .detail-dates, .detail-location { font-size: var(--text-sm); color: rgba(255,255,255,0.5); font-weight: 600; }
  .detail-desc { font-size: var(--text-sm); color: rgba(255,255,255,0.6); line-height: 1.6; }

  @media (max-width: 900px) {
    .map-panel-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-pin--current { animation: none; }
    #route-line { animation: none; stroke-dashoffset: 0; }
  }
</style>

<script>
  const FESTIVALS = [
    { id: 'cheltenham-jazz', num: 1, name: 'Cheltenham Jazz Festival', dates: '28 Apr – 5 May', location: 'Cheltenham, Gloucestershire', status: 'completed', desc: 'Our home patch. Scott grew up in Chipping Campden — Cheltenham Jazz is where the season begins.', url: 'https://www.cheltenhamfestivals.com/jazz' },
    { id: 'big-retreat', num: 2, name: 'The Big Retreat Festival', dates: '21 – 26 May', location: 'Lawrenny, Pembrokeshire', status: 'completed', desc: 'Wellness, music and good vibes on the Pembrokeshire coast. A different crowd, a brilliant atmosphere.', url: 'https://www.thebigretreatfestival.com/' },
    { id: '2000trees', num: 3, name: '2000trees Festival', dates: '7 – 12 Jul', location: 'Upcote Farm, Cheltenham', status: 'current', desc: "Consistently one of the best-run festivals in the UK. Indie, alternative, and we're proud to be part of it.", url: 'https://2000trees.co.uk/' },
    { id: 'emf', num: 4, name: 'Electromagnetic Field', dates: '16 – 19 Jul', location: 'Eastnor Castle, Herefordshire', status: 'upcoming', desc: 'Tech, art and making. A unique crowd who appreciate proper food as much as a good hack.', url: 'https://www.emfcamp.org/' },
    { id: 'camp-bestival', num: 5, name: 'Camp Bestival', dates: '29 Jul – 3 Aug', location: 'Lulworth Castle, Dorset', status: 'upcoming', desc: 'Family festival at a stunning Dorset castle. Big crowds, brilliant energy, and gyros going fast.', url: 'https://dorset.campbestival.net/' },
    { id: 'lakefest', num: 6, name: 'Lakefest', dates: '4 – 10 Aug', location: 'Eastnor Castle, Herefordshire', status: 'upcoming', desc: "Lakeside vibes, brilliant crowd, and a pitch right in the heart of the action. One of our favourites.", url: 'https://www.lakefest.co.uk/' },
    { id: 'beautiful-days', num: 7, name: 'Beautiful Days', dates: '20 – 24 Aug', location: 'Escot Park, Devon', status: 'upcoming', desc: 'An institution. Beautiful setting, loyal crowd, and Cornwall just down the road.', url: 'https://www.beautifuldays.org/' },
    { id: 'forwards', num: 8, name: 'Forwards Festival', dates: '26 – 31 Aug', location: 'Bristol', status: 'upcoming', desc: "Bristol's biggest music festival. Urban, diverse and seriously good fun.", url: 'https://www.forwardsbristol.co.uk/' },
    { id: 'we-have-ways', num: 9, name: 'We Have Ways Festival', dates: '10 – 14 Sep', location: 'Blackpit Farm, Buckinghamshire', status: 'upcoming', desc: 'History, music and community in the Buckinghamshire countryside. Season finale.', url: 'https://wehavewaysfest.co.uk/' },
  ];

  const STATUS_LABELS = { completed: 'COMPLETED ✓', current: 'CURRENT FESTIVAL ◉', upcoming: 'UPCOMING' };

  function selectFestival(id) {
    const f = FESTIVALS.find(fest => fest.id === id);
    if (!f) return;
    document.querySelectorAll('.map-pin').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tracker-item').forEach(t => t.classList.remove('active'));
    document.querySelector(`.map-pin[data-id="${id}"]`)?.classList.add('active');
    document.querySelector(`.tracker-item[data-id="${id}"]`)?.classList.add('active');
    document.getElementById('detail-status').textContent = STATUS_LABELS[f.status];
    document.getElementById('detail-name').textContent = f.name;
    document.getElementById('detail-dates').textContent = '📅 ' + f.dates;
    document.getElementById('detail-location').textContent = '📍 ' + f.location;
    document.getElementById('detail-desc').textContent = f.desc;
    const link = document.getElementById('detail-link');
    link.href = f.url;
    link.style.display = 'inline-flex';
  }

  document.querySelectorAll('.map-pin').forEach(pin => {
    pin.addEventListener('click', () => selectFestival(pin.dataset.id));
  });

  document.querySelectorAll('.tracker-item').forEach(item => {
    item.addEventListener('click', () => selectFestival(item.dataset.id));
    item.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') selectFestival(item.dataset.id); });
  });

  const nextDates = {
    'cheltenham-jazz': new Date('2026-04-28'), 'big-retreat': new Date('2026-05-21'),
    '2000trees': new Date('2026-07-07'), 'emf': new Date('2026-07-16'),
    'camp-bestival': new Date('2026-07-29'), 'lakefest': new Date('2026-08-04'),
    'beautiful-days': new Date('2026-08-20'), 'forwards': new Date('2026-08-26'),
    'we-have-ways': new Date('2026-09-10'),
  };

  const next = FESTIVALS.find(f => f.status === 'current') || FESTIVALS.find(f => f.status === 'upcoming');
  if (next) {
    const days = Math.max(0, Math.ceil((nextDates[next.id] - new Date()) / 86400000));
    document.getElementById('countdown-days').textContent = days;
  }

  const current = FESTIVALS.find(f => f.status === 'current');
  if (current) selectFestival(current.id);
</script>