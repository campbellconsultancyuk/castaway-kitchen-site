---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/menu', label: 'Food & Menu' },
  { href: '/festivals', label: 'Festivals' },
  { href: '/private-catering', label: 'Private Catering' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const { pathname } = Astro.url;

// Normalise trailing slashes so "/about/" matches "/about"
const normalise = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const currentPath = normalise(pathname);
const isActive = (href: string) => currentPath === normalise(href);
---

<header class="nav-wrapper">
  <div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label="Castaway Kitchen home">
      <img src="/castaway-logo.png" alt="Castaway Kitchen" width="52" height="52" />
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`nav-link ${isActive(link.href) ? 'nav-link--active' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav-right">
  <a href="https://www.instagram.com/castawaykitchen/" target="_blank" rel="noopener" aria-label="Instagram" class="nav-social">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
  </a>
  <a href="https://www.facebook.com/CastawayKitchen" target="_blank" rel="noopener" aria-label="Facebook" class="nav-social">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
  </a>
  <a href="https://x.com/jeveready" target="_blank" rel="noopener" aria-label="X (formerly Twitter)" class="nav-social">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
  </a>
  <a href="/contact" class="btn btn--primary nav-cta">Book Us</a>
</div>

    <!-- Mobile hamburger -->
    <button class="nav-hamburger" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav-mobile" id="mobile-menu" aria-hidden="true">
    {navLinks.map(link => (
      <a href={link.href} class={`nav-mobile-link ${isActive(link.href) ? 'nav-mobile-link--active' : ''}`}>{link.label}</a>
    ))}
    <a href="/contact" class="btn btn--primary" style="margin-top: 1rem; text-align: center;">Book Us</a>
  </div>
</header>

<style>
  .nav-right {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-left: auto;
}

.nav-social {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.5);
  transition: color 0.2s;
}

.nav-social:hover {
  color: var(--teal-light);
}
  .nav-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--black);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    transition: box-shadow 0.2s ease;
  }

  .nav-wrapper.scrolled {
    box-shadow: 0 2px 20px rgba(0,0,0,0.3);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    height: var(--nav-height);
  }

  .nav-logo img {
    border-radius: 50%;
    filter: invert(1);
    transition: opacity 0.2s;
  }

  .nav-logo:hover img {
    opacity: 0.8;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex: 1;
  }

  .nav-link {
    font-size: var(--text-sm);
    font-weight: 700;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--white);
  }

  .nav-link--active {
    color: var(--teal-light);
  }

  .nav-cta {
    flex-shrink: 0;
  }

  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-left: auto;
  }

  .nav-hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--white);
    transition: all 0.25s ease;
    transform-origin: center;
  }

  .nav-hamburger.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-hamburger.open span:nth-child(2) {
    opacity: 0;
  }
  .nav-hamburger.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: var(--space-md);
    background: var(--black);
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .nav-mobile.open {
    display: flex;
  }

  .nav-mobile-link {
    padding: 0.75rem 0;
    font-size: var(--text-base);
    font-weight: 700;
    color: rgba(255,255,255,0.8);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: color 0.2s;
  }

  .nav-mobile-link:hover,
  .nav-mobile-link--active {
    color: var(--teal-light);
  }

  @media (max-width: 900px) {
  .nav-links,
  .nav-right {
    display: none;
  }
    .nav-hamburger {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open');
    toggle.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(isOpen));
    menu?.setAttribute('aria-hidden', String(!isOpen));
  });

  // Scroll shadow
  window.addEventListener('scroll', () => {
    const nav = document.querySelector('.nav-wrapper');
    nav?.classList.toggle('scrolled', window.scrollY > 10);
  });
</script>